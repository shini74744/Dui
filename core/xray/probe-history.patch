index 0000000..e41e2d5
--- /dev/null
+++ b/app/stats/command/dui_probe_history.go
@@ -0,0 +1,57 @@
+package command
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/xtls/xray-core/common/duiprobehistory"
+	"google.golang.org/grpc"
+	"google.golang.org/protobuf/types/known/structpb"
+)
+
+const probeHistoryMethod = "/xray.app.stats.command.DUIProbeHistoryService/GetProbeHistory"
+
+type probeHistoryAPI interface {
+	GetProbeHistory(context.Context, *structpb.Struct) (*structpb.Struct, error)
+}
+type probeHistoryServer struct{ recorder *duiprobehistory.Recorder }
+
+func (s *probeHistoryServer) GetProbeHistory(ctx context.Context, request *structpb.Struct) (*structpb.Struct, error) {
+	fields := request.GetFields()
+	session := fields["session"].GetStringValue()
+	after := fields["after"].GetNumberValue()
+	if after < 0 {
+		after = 0
+	}
+	batch := s.recorder.Read(session, uint64(after), 500)
+	payload, err := json.Marshal(batch)
+	if err != nil {
+		return nil, err
+	}
+	values := map[string]interface{}{}
+	if err = json.Unmarshal(payload, &values); err != nil {
+		return nil, err
+	}
+	return structpb.NewStruct(values)
+}
+func registerProbeHistory(server *grpc.Server, recorder *duiprobehistory.Recorder) {
+	if recorder == nil {
+		return
+	}
+	server.RegisterService(&grpc.ServiceDesc{
+		ServiceName: "xray.app.stats.command.DUIProbeHistoryService",
+		HandlerType: (*probeHistoryAPI)(nil),
+		Methods: []grpc.MethodDesc{{MethodName: "GetProbeHistory", Handler: func(srv interface{}, ctx context.Context, dec func(interface{}) error, interceptor grpc.UnaryServerInterceptor) (interface{}, error) {
+			request := new(structpb.Struct)
+			if err := dec(request); err != nil {
+				return nil, err
+			}
+			handler := func(ctx context.Context, req interface{}) (interface{}, error) {
+				return srv.(probeHistoryAPI).GetProbeHistory(ctx, req.(*structpb.Struct))
+			}
+			if interceptor == nil {
+				return handler(ctx, request)
+			}
+			return interceptor(ctx, request, &grpc.UnaryServerInfo{Server: srv, FullMethod: probeHistoryMethod}, handler)
+		}}},
+	}, &probeHistoryServer{recorder: recorder})
+}
