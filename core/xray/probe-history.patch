@@ -0,0 +1,43 @@
+package command
+
+import (
+	"context"
+	"github.com/xtls/xray-core/common/duiprobehistory"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/grpc/test/bufconn"
+	"google.golang.org/protobuf/types/known/structpb"
+	"net"
+	"testing"
+)
+
+func TestDUIProbeHistoryRPC(t *testing.T) {
+	recorder := duiprobehistory.New()
+	recorder.Add(duiprobehistory.Event{Strategy: "random", Outbound: "shared", Status: "failed", Time: 1234})
+	listener := bufconn.Listen(1024 * 1024)
+	server := grpc.NewServer()
+	registerProbeHistory(server, recorder)
+	go server.Serve(listener)
+	defer server.Stop()
+	conn, err := grpc.NewClient("passthrough:///history", grpc.WithTransportCredentials(insecure.NewCredentials()), grpc.WithContextDialer(func(context.Context, string) (net.Conn, error) { return listener.Dial() }))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	out := new(structpb.Struct)
+	if err = conn.Invoke(context.Background(), probeHistoryMethod, &structpb.Struct{}, out); err != nil {
+		t.Fatal(err)
+	}
+	fields := out.GetFields()
+	events := fields["events"].GetListValue().Values
+	if len(events) != 1 || events[0].GetStructValue().Fields["status"].GetStringValue() != "failed" {
+		t.Fatal("real RPC lost raw result")
+	}
+	request, _ := structpb.NewStruct(map[string]interface{}{"session": fields["session"].GetStringValue(), "after": float64(1)})
+	if err = conn.Invoke(context.Background(), probeHistoryMethod, request, out); err != nil {
+		t.Fatal(err)
+	}
+	if len(out.GetFields()["events"].GetListValue().Values) != 0 {
+		t.Fatal("cursor repeated event")
+	}
+}
diff --git a/common/duiprobehistory/history.go b/common/duiprobehistory/history.go
new file mode 100644
index 0000000..05e960b
--- /dev/null
+++ b/common/duiprobehistory/history.go
@@ -0,0 +1,100 @@
+// Package duiprobehistory buffers completed probes without changing routing measurements.
+package duiprobehistory
+
+import (
+	"context"
+	"crypto/rand"
+	"sync"
+	"time"
+)
+
+const Capacity = 4096
+
+type Event struct {
+	Sequence uint64  `json:"sequence"`
+	Time     int64   `json:"time"`
+	Strategy string  `json:"strategy"`
+	Outbound string  `json:"outbound"`
+	Status   string  `json:"status"`
+	Delay    float64 `json:"delay"`
+}
+type Batch struct {
+	Session string  `json:"session"`
+	Events  []Event `json:"events"`
+	Next    uint64  `json:"next"`
+	Latest  uint64  `json:"latest"`
+	Missed  bool    `json:"missed"`
+}
+type Recorder struct {
+	mu       sync.Mutex
+	session  string
+	sequence uint64
+	events   []Event
+}
+type recorderKey struct{}
+type strategyKey struct{}
+
+func New() *Recorder { return &Recorder{session: rand.Text()} }
+func WithRecorder(ctx context.Context, r *Recorder) context.Context {
+	return context.WithValue(ctx, recorderKey{}, r)
+}
+func FromContext(ctx context.Context) *Recorder {
+	if ctx == nil {
+		return nil
+	}
+	r, _ := ctx.Value(recorderKey{}).(*Recorder)
+	return r
+}
+func WithStrategy(ctx context.Context, name string) context.Context {
+	return context.WithValue(ctx, strategyKey{}, name)
+}
+func Record(ctx context.Context, fallback, tag, state string, delay float64) {
+	r := FromContext(ctx)
+	if r == nil {
+		return
+	}
+	name, _ := ctx.Value(strategyKey{}).(string)
+	if name == "" {
+		name = fallback
+	}
+	r.Add(Event{Time: time.Now().UnixMilli(), Strategy: name, Outbound: tag, Status: state, Delay: delay})
+}
+func (r *Recorder) Add(e Event) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.sequence++
+	e.Sequence = r.sequence
+	if r.events == nil {
+		r.events = make([]Event, Capacity)
+	}
+	r.events[(e.Sequence-1)%Capacity] = e
+}
+func (r *Recorder) Read(session string, after uint64, limit int) Batch {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if limit < 1 || limit > 500 {
+		limit = 500
+	}
+	out := Batch{Session: r.session, Events: []Event{}, Latest: r.sequence}
+	if session != r.session {
+		after = 0
+	}
+	first := uint64(1)
+	if r.sequence > Capacity {
+		first = r.sequence - Capacity + 1
+	}
+	out.Missed = after+1 < first
+	if after >= r.sequence {
+		out.Next = r.sequence
+		return out
+	}
+	if after+1 < first {
+		after = first - 1
+	}
+	out.Next = after
+	for n := after + 1; n <= r.sequence && len(out.Events) < limit; n++ {
+		out.Events = append(out.Events, r.events[(n-1)%Capacity])
+		out.Next = n
+	}
+	return out
+}
diff --git a/common/duiprobehistory/history_test.go b/common/duiprobehistory/history_test.go
