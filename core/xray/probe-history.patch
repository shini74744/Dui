index 0000000..98b238f
--- /dev/null
+++ b/common/duiprobehistory/history_test.go
@@ -0,0 +1,43 @@
+package duiprobehistory
+
+import (
+	"context"
+	"sync"
+	"testing"
+)
+
+func TestDUIBoundedHistoryCursorAndIsolation(t *testing.T) {
+	r := New()
+	ctx := WithRecorder(context.Background(), r)
+	for i := 0; i < Capacity+5; i++ {
+		Record(WithStrategy(ctx, "random"), "legacyBurst", "shared", "success", float64(i))
+	}
+	b := r.Read("", 0, 500)
+	if !b.Missed || len(b.Events) != 500 || b.Events[0].Sequence != 6 || b.Events[0].Strategy != "random" {
+		t.Fatalf("bad batch: %+v", b)
+	}
+	next := r.Read(b.Session, b.Next, 500)
+	if next.Events[0].Sequence != b.Next+1 {
+		t.Fatal("cursor lost records")
+	}
+	if len(New().Read(b.Session, 0, 500).Events) != 0 {
+		t.Fatal("instance leak")
+	}
+	restarted := New()
+	restarted.Add(Event{Strategy: "leastPing"})
+	if len(restarted.Read(b.Session, b.Next, 500).Events) != 1 {
+		t.Fatal("restart cursor not reset")
+	}
+	var wg sync.WaitGroup
+	for i := 0; i < 4; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for j := 0; j < 100; j++ {
+				r.Add(Event{})
+				r.Read("", 0, 5)
+			}
+		}()
+	}
+	wg.Wait()
+}
