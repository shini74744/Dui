+package duilimit
+
+import (
+	"context"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/net"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type sink struct {
+	n       atomic.Int64
+	packets atomic.Int64
+	udp     bool
+}
+
+func (s *sink) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	for _, b := range mb {
+		if s.udp && b.UDP == nil {
+			panic("lost UDP destination")
+		}
+		s.n.Add(int64(b.Len()))
+		s.packets.Add(1)
+	}
+	buf.ReleaseMulti(mb)
+	return nil
+}
+func push(t *testing.T, w buf.Writer, n int, udp bool) {
+	t.Helper()
+	for i := 0; i < n; i++ {
+		b := buf.New()
+		b.Extend(buf.Size)
+		if udp {
+			b.UDP = &net.Destination{Network: net.Network_UDP, Address: net.LocalHostIP, Port: 53}
+		}
+		if err := w.WriteMultiBuffer(buf.MultiBuffer{b}); err != nil {
+			t.Error(err)
+			return
+		}
+	}
+}
+func TestAggregateIndependentDirectionsAndUsers(t *testing.T) {
+	var r Registry
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	dst := &sink{udp: true}
+	const speed = uint32(buf.Size * 20)
+	a := r.Writer(ctx, "a", LevelFlag|speed, true, dst).(*Writer)
+	b := r.Writer(ctx, "a", LevelFlag|speed, true, dst).(*Writer)
+	down := r.Writer(ctx, "a", LevelFlag|speed, false, dst).(*Writer)
+	other := r.Writer(ctx, "b", LevelFlag|speed, true, dst).(*Writer)
+	defer a.Close()
+	defer b.Close()
+	defer down.Close()
+	defer other.Close()
+	if a.lim != b.lim || a.lim == down.lim || a.lim == other.lim {
+		t.Fatal("incorrect sharing")
+	}
+	start := time.Now()
+	var wg sync.WaitGroup
+	for _, spec := range []struct {
+		w buf.Writer
+		n int
+	}{{a, 10}, {b, 10}, {down, 20}, {other, 20}} {
+		wg.Add(1)
+		go func() { defer wg.Done(); push(t, spec.w, spec.n, true) }()
+	}
+	wg.Wait()
+	elapsed := time.Since(start)
+	if elapsed < 900*time.Millisecond || elapsed > 1900*time.Millisecond {
+		t.Fatalf("aggregate/direction throughput incorrect: %v", elapsed)
+	}
+	if dst.packets.Load() != 60 || dst.n.Load() != 60*buf.Size {
+		t.Fatal("packet loss")
+	}
+}
+func TestCancellationUnlimitedAndCleanup(t *testing.T) {
+	var r Registry
+	ctx, cancel := context.WithCancel(context.Background())
+	dst := &sink{}
+	if r.Writer(ctx, "a", 0, true, dst) != dst {
+		t.Fatal("unlimited wrapped")
+	}
+	w := r.Writer(ctx, "a", LevelFlag|1, true, dst).(*Writer)
+	push(t, w, 1, false)
+	done := make(chan error, 1)
+	go func() { b := buf.New(); b.Extend(buf.Size); done <- w.WriteMultiBuffer(buf.MultiBuffer{b}) }()
+	cancel()
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("missing cancellation")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("limiter blocked close")
+	}
+	w.Close()
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.users["a"].refs != 0 {
+		t.Fatal("reference leak")
+	}
+}
