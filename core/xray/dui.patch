+package tls_test
+
+import (
+	"crypto/sha256"
+	"crypto/tls"
+	xtls "github.com/xtls/xray-core/transport/internet/tls"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestDUIInsecureAndPin(t *testing.T) {
+	s := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(204) }))
+	defer s.Close()
+	pin := sha256.Sum256(s.Certificate().Raw)
+	for _, tc := range []struct {
+		name string
+		cfg  *xtls.Config
+		ok   bool
+	}{{"strict", &xtls.Config{}, false}, {"opt-in", &xtls.Config{AllowInsecure: true}, true}, {"valid-pin", &xtls.Config{AllowInsecure: true, PinnedPeerCertSha256: [][]byte{pin[:]}}, true}, {"wrong-pin", &xtls.Config{AllowInsecure: true, PinnedPeerCertSha256: [][]byte{make([]byte, 32)}}, false}} {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg := tc.cfg.GetTLSConfig()
+			cfg.NextProtos = []string{"http/1.1"}
+			tr := &http.Transport{TLSClientConfig: cfg}
+			defer tr.CloseIdleConnections()
+			c := http.Client{Transport: tr}
+			resp, err := c.Get(s.URL)
+			if resp != nil {
+				resp.Body.Close()
+			}
+			if (err == nil) != tc.ok {
+				t.Fatalf("handshake got %v expected success=%v", err, tc.ok)
+			}
+		})
+	}
+	_ = tls.VersionTLS13
+}
