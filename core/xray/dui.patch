+)
+
+func port(t *testing.T) int {
+	l, e := net.Listen("tcp", "127.0.0.1:0")
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer l.Close()
+	return l.Addr().(*net.TCPAddr).Port
+}
+func start(t *testing.T, c map[string]any) {
+	b, e := json.Marshal(c)
+	if e != nil {
+		t.Fatal(e)
+	}
+	s, e := core.StartInstance("json", b)
+	if e != nil {
+		t.Fatal(e)
+	}
+	t.Cleanup(func() { s.Close() })
+}
+func TestDUIRealTCPAggregate(t *testing.T) {
+	for _, kind := range []string{"vless", "vless-mux", "vless-reality", "shadowsocks"} {
+		t.Run(kind, func(t *testing.T) {
+			variant := kind
+			protocolName := kind
+			if kind == "vless-mux" || kind == "vless-reality" {
+				protocolName = "vless"
+			}
+			kind = protocolName
+			echo, e := net.Listen("tcp", "127.0.0.1:0")
+			if e != nil {
+				t.Fatal(e)
+			}
+			defer echo.Close()
+			go func() {
+				for {
+					c, e := echo.Accept()
+					if e != nil {
+						return
+					}
+					go func() { defer c.Close(); io.Copy(c, c) }()
+				}
+			}()
+			serverPort, clientPort := port(t), port(t)
+			id := "82de13e6-2df5-4dd4-b2b0-4c8878b8dc09"
+			key := base64.StdEncoding.EncodeToString([]byte("0123456789abcdef"))
+			userKey := base64.StdEncoding.EncodeToString([]byte("fedcba9876543210"))
+			level := uint32(1<<31) | 250000
+			var sin, cout map[string]any
+			if kind == "vless" {
+				sin = map[string]any{"clients": []any{map[string]any{"id": id, "email": "dui-test", "level": level}}, "decryption": "none"}
+				cout = map[string]any{"vnext": []any{map[string]any{"address": "127.0.0.1", "port": serverPort, "users": []any{map[string]any{"id": id, "encryption": "none"}}}}}
+			} else {
+				sin = map[string]any{"method": "2022-blake3-aes-128-gcm", "password": key, "network": "tcp,udp", "clients": []any{map[string]any{"password": userKey, "email": "dui-test", "level": level}}}
+				cout = map[string]any{"servers": []any{map[string]any{"address": "127.0.0.1", "port": serverPort, "method": "2022-blake3-aes-128-gcm", "password": key + ":" + userKey}}}
+			}
+			var privateKey, publicKey, target string
+			if variant == "vless-reality" {
+				key, err := ecdh.X25519().GenerateKey(rand.Reader)
+				if err != nil {
+					t.Fatal(err)
+				}
+				privateKey = base64.RawURLEncoding.EncodeToString(key.Bytes())
+				publicKey = base64.RawURLEncoding.EncodeToString(key.PublicKey().Bytes())
+				camouflage := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(200) }))
+				camouflage.TLS = &tls.Config{MinVersion: tls.VersionTLS13, CurvePreferences: []tls.CurveID{tls.X25519}}
+				camouflage.EnableHTTP2 = true
+				camouflage.StartTLS()
+				defer camouflage.Close()
+				target = camouflage.Listener.Addr().String()
+			}
+			transportConfig := func(c map[string]any, server bool) map[string]any {
+				if variant == "vless-mux" && !server {
+					c["outbounds"].([]any)[0].(map[string]any)["mux"] = map[string]any{"enabled": true, "concurrency": 4}
+				}
+				if variant == "vless-reality" {
+					var endpoint map[string]any
+					var reality map[string]any
+					if server {
+						endpoint = c["inbounds"].([]any)[0].(map[string]any)
+						sin["clients"].([]any)[0].(map[string]any)["flow"] = "xtls-rprx-vision"
+						reality = map[string]any{"dest": target, "serverNames": []string{"example.com"}, "privateKey": privateKey, "shortIds": []string{"12345678"}}
+					} else {
+						endpoint = c["outbounds"].([]any)[0].(map[string]any)
+						cout["vnext"].([]any)[0].(map[string]any)["users"].([]any)[0].(map[string]any)["flow"] = "xtls-rprx-vision"
+						reality = map[string]any{"serverName": "example.com", "publicKey": publicKey, "shortId": "12345678", "fingerprint": "chrome"}
+					}
+					endpoint["streamSettings"] = map[string]any{"network": "tcp", "security": "reality", "realitySettings": reality}
+				}
+				return c
+			}
+
+			start(t, transportConfig(map[string]any{"log": map[string]any{"loglevel": "error", "access": "none"}, "inbounds": []any{map[string]any{"listen": "127.0.0.1", "port": serverPort, "protocol": kind, "settings": sin}}, "outbounds": []any{map[string]any{"protocol": "freedom", "settings": map[string]any{"finalRules": []any{map[string]any{"action": "allow"}}}}}}, true))
+			start(t, transportConfig(map[string]any{"log": map[string]any{"loglevel": "error", "access": "none"}, "inbounds": []any{map[string]any{"listen": "127.0.0.1", "port": clientPort, "protocol": "dokodemo-door", "settings": map[string]any{"address": "127.0.0.1", "port": echo.Addr().(*net.TCPAddr).Port, "network": "tcp"}}}, "outbounds": []any{map[string]any{"protocol": kind, "settings": cout}}}, false))
+			// Establish all protocol handshakes before measuring application throughput.
+			connections := make([]net.Conn, 4)
+			var ready sync.WaitGroup
+			for i := range connections {
+				ready.Add(1)
+				go func() {
+					defer ready.Done()
+					c, e := net.Dial("tcp", "127.0.0.1:"+strconv.Itoa(clientPort))
+					if e != nil {
+						t.Error(e)
+						return
+					}
+					connections[i] = c
+					c.SetDeadline(time.Now().Add(30 * time.Second))
+					if _, e = c.Write([]byte{1}); e != nil {
+						t.Error(e)
+						return
+					}
+					if _, e = io.ReadFull(c, make([]byte, 1)); e != nil {
+						t.Error(e)
+					}
+				}()
+			}
+			ready.Wait()
+			if t.Failed() {
+				for _, c := range connections {
+					if c != nil {
+						c.Close()
+					}
+				}
+				t.FailNow()
+			}
+			begin := time.Now()
+			var wg sync.WaitGroup
+			for _, c := range connections {
+				wg.Add(1)
+				go func() {
+					defer wg.Done()
+					defer c.Close()
+					var e error
+					send := make(chan error, 1)
+					go func() { _, e := c.Write(make([]byte, 250000)); send <- e }()
+					n, e := io.CopyN(io.Discard, c, 250000)
+					if e != nil || n != 250000 {
+						t.Errorf("copy %d: %v", n, e)
+					}
+					if e = <-send; e != nil {
+						t.Error(e)
+					}
+				}()
+			}
+			wg.Wait()
+			elapsed := time.Since(begin)
+			if elapsed < 3800*time.Millisecond || elapsed > 7500*time.Millisecond {
+				t.Fatalf("expected aggregate 2 Mbps duplex (~4s), got %v", elapsed)
+			}
+			t.Logf("%s 4 concurrent connections, upload/download 1 MB each: %v", variant, elapsed)
+		})
+	}
+}
