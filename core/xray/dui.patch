+func TestDUIRealityFingerprintCompatibility(t *testing.T) {
+	key, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	privateKey := base64.RawURLEncoding.EncodeToString(key.Bytes())
+	publicKey := base64.RawURLEncoding.EncodeToString(key.PublicKey().Bytes())
+	camouflage := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(200) }))
+	camouflage.TLS = &tls.Config{MinVersion: tls.VersionTLS13, CurvePreferences: []tls.CurveID{tls.X25519}}
+	camouflage.EnableHTTP2 = true
+	camouflage.StartTLS()
+	defer camouflage.Close()
+	echo, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer echo.Close()
+	go func() {
+		for {
+			c, e := echo.Accept()
+			if e != nil {
+				return
+			}
+			go func() { defer c.Close(); io.Copy(c, c) }()
+		}
+	}()
+	const id = "82de13e6-2df5-4dd4-b2b0-4c8878b8dc09"
+	serverPorts := []int{port(t), port(t)}
+	var inbounds []any
+	for i, p := range serverPorts {
+		r := map[string]any{"target": camouflage.Listener.Addr().String(), "serverNames": []string{"example.com"}, "privateKey": privateKey, "shortIds": []string{"12345678"}}
+		if i == 1 {
+			r["duiRequireHybridKeyShare"] = true
+		} // Absent means legacy-compatible.
+		inbounds = append(inbounds, map[string]any{"tag": fmt.Sprint("mode-", i), "listen": "127.0.0.1", "port": p, "protocol": "vless", "settings": map[string]any{"clients": []any{map[string]any{"id": id}}, "decryption": "none"}, "streamSettings": map[string]any{"network": "tcp", "security": "reality", "realitySettings": r}})
+	}
+	start(t, map[string]any{"log": map[string]any{"loglevel": "none", "access": "none"}, "inbounds": inbounds, "outbounds": []any{map[string]any{"protocol": "freedom", "settings": map[string]any{"finalRules": []any{map[string]any{"action": "allow"}}}}}})
+	cases := []struct {
+		name    string
+		mode    int
+		fp, bad string
+		want    bool
+	}{
+		{"compatible-old", 0, "hellochrome_120", "", true},
+		{"compatible-new", 0, "chrome", "", true},
+		{"strict-old", 1, "hellochrome_120", "", false},
+		{"strict-new", 1, "chrome", "", true},
+		{"compatible-bad-key", 0, "hellochrome_120", "key", false},
+		{"compatible-bad-short-id", 0, "hellochrome_120", "short-id", false},
+		{"compatible-bad-sni", 0, "hellochrome_120", "sni", false},
+		{"compatible-bad-user", 0, "hellochrome_120", "user", false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			clientPort := port(t)
+			r := map[string]any{"serverName": "example.com", "publicKey": publicKey, "shortId": "12345678", "fingerprint": tc.fp}
+			user := map[string]any{"id": id, "encryption": "none"}
+			switch tc.bad {
+			case "key":
+				k, _ := ecdh.X25519().GenerateKey(rand.Reader)
+				r["publicKey"] = base64.RawURLEncoding.EncodeToString(k.PublicKey().Bytes())
+			case "short-id":
+				r["shortId"] = "ffffffff"
+			case "sni":
+				r["serverName"] = "other.example"
+			case "user":
+				user["id"] = "82de13e6-2df5-4dd4-b2b0-4c8878b8dc08"
+			}
+			start(t, map[string]any{"log": map[string]any{"loglevel": "none", "access": "none"}, "inbounds": []any{map[string]any{"listen": "127.0.0.1", "port": clientPort, "protocol": "dokodemo-door", "settings": map[string]any{"address": "127.0.0.1", "port": echo.Addr().(*net.TCPAddr).Port, "network": "tcp"}}}, "outbounds": []any{map[string]any{"protocol": "vless", "settings": map[string]any{"vnext": []any{map[string]any{"address": "127.0.0.1", "port": serverPorts[tc.mode], "users": []any{user}}}}, "streamSettings": map[string]any{"network": "tcp", "security": "reality", "realitySettings": r}}}})
+			c, err := net.DialTimeout("tcp", fmt.Sprintf("127.0.0.1:%d", clientPort), time.Second)
+			if err != nil {
