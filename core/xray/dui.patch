+func TestDUIRealSS2022UDP(t *testing.T) {
+	echo, e := net.ListenPacket("udp", "127.0.0.1:0")
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer echo.Close()
+	go func() {
+		b := make([]byte, 2048)
+		for {
+			n, a, e := echo.ReadFrom(b)
+			if e != nil {
+				return
+			}
+			echo.WriteTo(b[:n], a)
+		}
+	}()
+	sp, cp := port(t), port(t)
+	key := base64.StdEncoding.EncodeToString([]byte("0123456789abcdef"))
+	uk := base64.StdEncoding.EncodeToString([]byte("fedcba9876543210"))
+	start(t, map[string]any{"log": map[string]any{"loglevel": "error", "access": "none"}, "inbounds": []any{map[string]any{"listen": "127.0.0.1", "port": sp, "protocol": "shadowsocks", "settings": map[string]any{"method": "2022-blake3-aes-128-gcm", "password": key, "network": "udp", "clients": []any{map[string]any{"email": "udp-test", "password": uk, "level": uint32(1<<31) | 16000}}}}}, "outbounds": []any{map[string]any{"protocol": "freedom", "settings": map[string]any{"finalRules": []any{map[string]any{"action": "allow"}}}}}})
+	start(t, map[string]any{"log": map[string]any{"loglevel": "error", "access": "none"}, "inbounds": []any{map[string]any{"listen": "127.0.0.1", "port": cp, "protocol": "dokodemo-door", "settings": map[string]any{"address": "127.0.0.1", "port": echo.LocalAddr().(*net.UDPAddr).Port, "network": "udp"}}}, "outbounds": []any{map[string]any{"protocol": "shadowsocks", "settings": map[string]any{"servers": []any{map[string]any{"address": "127.0.0.1", "port": sp, "method": "2022-blake3-aes-128-gcm", "password": key + ":" + uk}}}}}})
+	c, e := net.Dial("udp", "127.0.0.1:"+strconv.Itoa(cp))
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer c.Close()
+	c.SetDeadline(time.Now().Add(15 * time.Second))
+	payload := make([]byte, 1000)
+	received := make([]byte, 2048)
+	begin := time.Now()
+	for i := range 48 {
+		payload[0] = byte(i)
+		if _, e = c.Write(payload); e != nil {
+			t.Fatal(e)
+		}
+		n, e := c.Read(received)
+		if e != nil || !bytes.Equal(payload, received[:n]) {
+			t.Fatalf("UDP packet %d corrupted/lost: %v", i, e)
+		}
+	}
+	elapsed := time.Since(begin)
+	if elapsed < 2450*time.Millisecond || elapsed > 7*time.Second {
+		t.Fatalf("128 kbps UDP rate: %v", elapsed)
+	}
+	t.Logf("SS2022 UDP 48 intact packets, upload/download 48 KB each: %v", elapsed)
+}
