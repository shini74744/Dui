@@ -0,0 +1,180 @@
+// Package duilimit implements DUI's aggregate per-user, per-direction bandwidth cap.
+package duilimit
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"golang.org/x/time/rate"
+)
+
+// Reserved user levels encode bytes/second; ordinary upstream levels retain their meaning.
+const LevelFlag uint32 = 1 << 31
+
+func BytesPerSecond(level uint32) uint32 {
+	if level&LevelFlag == 0 {
+		return 0
+	}
+	return level & (LevelFlag - 1)
+}
+
+type entry struct {
+	up, down   *rate.Limiter
+	refs       int
+	generation uint64
+}
+type Registry struct {
+	mu    sync.Mutex
+	users map[string]*entry
+}
+
+func (r *Registry) acquire(key string, speed uint32) (*entry, func()) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.users == nil {
+		r.users = make(map[string]*entry)
+	}
+	e := r.users[key]
+	if e == nil {
+		// One core buffer of burst per direction, shared by all this user's connections.
+		e = &entry{up: rate.NewLimiter(rate.Limit(speed), buf.Size), down: rate.NewLimiter(rate.Limit(speed), buf.Size)}
+		r.users[key] = e
+	} else {
+		e.up.SetLimit(rate.Limit(speed))
+		e.down.SetLimit(rate.Limit(speed))
+	}
+	e.refs++
+	e.generation++
+	var once sync.Once
+	return e, func() {
+		once.Do(func() {
+			r.mu.Lock()
+			defer r.mu.Unlock()
+			e.refs--
+			if e.refs == 0 {
+				generation := e.generation
+				delay := time.Duration(float64(buf.Size)/float64(e.up.Limit())*float64(time.Second)) + time.Second
+				time.AfterFunc(delay, func() {
+					r.mu.Lock()
+					defer r.mu.Unlock()
+					if e.refs == 0 && e.generation == generation && r.users[key] == e {
+						delete(r.users, key)
+					}
+				})
+			}
+		})
+	}
+}
+
+type life struct {
+	ctx     context.Context
+	cancel  context.CancelFunc
+	release func()
+	stop    func() bool
+	once    sync.Once
+}
+
+func newLife(ctx context.Context, release func()) *life {
+	child, cancel := context.WithCancel(ctx)
+	l := &life{ctx: child, cancel: cancel, release: release}
+	l.stop = context.AfterFunc(child, release)
+	return l
+}
+func (l *life) close() { l.once.Do(func() { l.cancel(); l.stop(); l.release() }) }
+
+type Writer struct {
+	buf.Writer
+	lim  *rate.Limiter
+	life *life
+}
+
+func (w *Writer) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	for i, b := range mb {
+		if b == nil {
+			continue
+		}
+		// Buffers, including UDP datagrams, must not be split or lose their destination.
+		remaining := int(b.Len())
+		for remaining > 0 {
+			n := remaining
+			if n > buf.Size {
+				n = buf.Size
+			}
+			if err := w.lim.WaitN(w.life.ctx, n); err != nil {
+				buf.ReleaseMulti(mb[i:])
+				w.life.close()
+				return err
+			}
+			remaining -= n
+		}
+		if err := w.Writer.WriteMultiBuffer(buf.MultiBuffer{b}); err != nil {
+			buf.ReleaseMulti(mb[i+1:])
+			w.life.close()
+			return err
+		}
+	}
+	return nil
+}
+func (w *Writer) Close() error { w.life.close(); return common.Close(w.Writer) }
+func (w *Writer) Interrupt()   { w.life.close(); common.Interrupt(w.Writer) }
+
+type Reader struct {
+	buf.Reader
+	lim  *rate.Limiter
+	life *life
+}
+
+func (r *Reader) throttle(mb buf.MultiBuffer, err error) (buf.MultiBuffer, error) {
+	for _, b := range mb {
+		if b == nil {
+			continue
+		}
+		for left := int(b.Len()); left > 0; {
+			n := left
+			if n > buf.Size {
+				n = buf.Size
+			}
+			if e := r.lim.WaitN(r.life.ctx, n); e != nil {
+				buf.ReleaseMulti(mb)
+				return nil, e
+			}
+			left -= n
+		}
+	}
+	return mb, err
+}
+func (r *Reader) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	return r.throttle(r.Reader.ReadMultiBuffer())
+}
+func (r *Reader) ReadMultiBufferTimeout(d time.Duration) (buf.MultiBuffer, error) {
+	if rr, ok := r.Reader.(buf.TimeoutReader); ok {
+		return r.throttle(rr.ReadMultiBufferTimeout(d))
+	}
+	return r.ReadMultiBuffer()
+}
+func (r *Reader) Close() error { r.life.close(); return common.Close(r.Reader) }
+func (r *Reader) Interrupt()   { r.life.close(); common.Interrupt(r.Reader) }
+
+func (r *Registry) Writer(ctx context.Context, key string, level uint32, up bool, w buf.Writer) buf.Writer {
+	speed := BytesPerSecond(level)
+	if speed == 0 || key == "" {
+		return w
+	}
+	e, release := r.acquire(key, speed)
+	lim := e.down
+	if up {
+		lim = e.up
+	}
+	return &Writer{Writer: w, lim: lim, life: newLife(ctx, release)}
+}
+func (r *Registry) Reader(ctx context.Context, key string, level uint32, rd buf.Reader) buf.Reader {
+	speed := BytesPerSecond(level)
+	if speed == 0 || key == "" {
+		return rd
+	}
+	e, release := r.acquire(key, speed)
+	return &Reader{Reader: rd, lim: e.up, life: newLife(ctx, release)}
+}
