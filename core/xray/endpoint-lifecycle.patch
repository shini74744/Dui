+package dui_test
+
+import (
+	"context"
+	"encoding/json"
+	"net"
+	"runtime"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/features/outbound"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/pipe"
+)
+
+func TestDUIEndpointOverrideDispatchLifecycle(t *testing.T) {
+	for _, mode := range []string{"cancel", "idle_timeout", "response_error"} {
+		t.Run(mode, func(t *testing.T) {
+			echo, err := net.ListenPacket("udp", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer echo.Close()
+			go func() {
+				b := make([]byte, 2048)
+				for {
+					n, a, err := echo.ReadFrom(b)
+					if err != nil {
+						return
+					}
+					echo.WriteTo(b[:n], a)
+				}
+			}()
+			cfg := map[string]any{
+				"log":       map[string]any{"loglevel": "none"},
+				"policy":    map[string]any{"levels": map[string]any{"0": map[string]any{"connIdle": 1, "uplinkOnly": 0, "downlinkOnly": 0}}},
+				"outbounds": []any{map[string]any{"tag": "direct", "protocol": "freedom", "settings": map[string]any{"finalRules": []any{map[string]any{"action": "allow"}}}}},
+			}
+			raw, _ := json.Marshal(cfg)
+			instance, err := core.StartInstance("json", raw)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer instance.Close()
+			handler := instance.GetFeature(outbound.ManagerType()).(outbound.Manager).GetHandler("direct")
+			if handler == nil {
+				t.Fatal("missing direct handler")
+			}
+			iterations := 8
+			if mode == "cancel" {
+				iterations = 1024
+			}
+			runtime.GC()
+			baselineGoroutines := runtime.NumGoroutine()
+			var baseline runtime.MemStats
+			runtime.ReadMemStats(&baseline)
+			for attempt := 0; attempt < iterations; attempt++ {
+				ctx, cancel := context.WithCancel(context.WithValue(context.Background(), core.XrayKey(1), instance))
+				port := xnet.Port(echo.LocalAddr().(*net.UDPAddr).Port)
+				original := xnet.UDPDestination(xnet.DomainAddress("original.test"), port)
+				target := xnet.UDPDestination(xnet.IPAddress([]byte{127, 0, 0, 1}), port)
+				ctx = session.ContextWithOutbounds(ctx, []*session.Outbound{{OriginalTarget: original, Target: target}})
+				upR, upW := pipe.New()
+				downR, downW := pipe.New()
+				done := make(chan struct{})
+				go func() { handler.Dispatch(ctx, &transport.Link{Reader: upR, Writer: downW}); close(done) }()
+				b := buf.New()
+				b.Write([]byte("endpoint-lifecycle"))
+				b.UDP = &original
+				if err := upW.WriteMultiBuffer(buf.MultiBuffer{b}); err != nil {
+					t.Fatal(err)
+				}
+				reply, err := downR.ReadMultiBufferTimeout(2 * time.Second)
+				if err != nil || len(reply) != 1 || string(reply[0].Bytes()) != "endpoint-lifecycle" {
+					t.Fatalf("UDP forwarding failed: %v", err)
+				}
+				buf.ReleaseMulti(reply)
+				switch mode {
+				case "cancel":
+					cancel()
+				case "response_error":
+					downR.Interrupt()
+					b = buf.New()
+					b.Write([]byte("fail-response"))
+					b.UDP = &original
+					_ = upW.WriteMultiBuffer(buf.MultiBuffer{b})
+				}
+				select {
+				case <-done:
+				case <-time.After(3 * time.Second):
+					cancel()
+					upR.Interrupt()
+					downR.Interrupt()
+					t.Fatal("dispatch did not end")
+				}
+				// The outbound must release the underlying pipe even after endpoint wrapping.
+				_, readErr := upR.ReadMultiBufferTimeout(200 * time.Millisecond)
+				cancel()
+				common.Interrupt(upR)
+				common.Interrupt(downR)
+				if mode == "cancel" && (attempt+1)%256 == 0 {
+					time.Sleep(50 * time.Millisecond)
+					runtime.GC()
+					var current runtime.MemStats
+					runtime.ReadMemStats(&current)
+					growth := int64(current.HeapAlloc) - int64(baseline.HeapAlloc)
+					goroutines := runtime.NumGoroutine() - baselineGoroutines
+					t.Logf("closed UDP sessions=%d goroutine_delta=%d heap_delta=%d", attempt+1, goroutines, growth)
+					if goroutines > 16 || growth > 16<<20 {
+						t.Fatalf("UDP tasks retained after cancellation: goroutines=%d heap=%d", goroutines, growth)
+					}
+				}
+				if readErr == nil || readErr == buf.ErrReadTimeout {
+					t.Fatalf("underlying request reader not released: %v", readErr)
+				}
+			}
+		})
+	}
+}
