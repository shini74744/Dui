+package buf_test
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/transport/pipe"
+)
+
+func TestDUIEndpointOverrideReaderInterrupt(t *testing.T) {
+	const count = 256
+	done := make(chan error, count)
+	readers := make([]*pipe.Reader, count)
+	var ready sync.WaitGroup
+	ready.Add(count)
+	for i := range readers {
+		reader, _ := pipe.New()
+		readers[i] = reader
+		wrapped := &buf.EndpointOverrideReader{Reader: reader}
+		go func() { ready.Done(); _, err := wrapped.ReadMultiBuffer(); done <- err }()
+	}
+	t.Cleanup(func() {
+		for _, r := range readers {
+			r.Interrupt()
+		}
+	})
+	ready.Wait()
+	for _, r := range readers {
+		common.Interrupt(&buf.EndpointOverrideReader{Reader: r})
+	}
+	timer := time.NewTimer(2 * time.Second)
+	defer timer.Stop()
+	for range count {
+		select {
+		case err := <-done:
+			if err == nil {
+				t.Fatal("interrupted read succeeded")
+			}
+		case <-timer.C:
+			t.Fatal("wrapped readers remained blocked")
+		}
+	}
+}
+
+func TestDUIEndpointOverrideWriterLifecycle(t *testing.T) {
+	for _, interrupt := range []bool{false, true} {
+		t.Run(map[bool]string{false: "close_drains", true: "interrupt_discards"}[interrupt], func(t *testing.T) {
+			reader, writer := pipe.New()
+			defer reader.Interrupt()
+			original := net.DomainAddress("original.test")
+			target := net.IPAddress([]byte{127, 0, 0, 1})
+			wrapped := &buf.EndpointOverrideWriter{Writer: writer, Dest: target, OriginalDest: original}
+			b := buf.New()
+			b.Write([]byte("response"))
+			b.UDP = &net.Destination{Network: net.Network_UDP, Address: target, Port: 53}
+			if err := wrapped.WriteMultiBuffer(buf.MultiBuffer{b}); err != nil {
+				t.Fatal(err)
+			}
+			if interrupt {
+				common.Interrupt(wrapped)
+			} else if err := common.Close(wrapped); err != nil {
+				t.Fatal(err)
+			}
+			mb, err := reader.ReadMultiBufferTimeout(time.Second)
+			defer buf.ReleaseMulti(mb)
+			if interrupt {
+				if err == nil || len(mb) != 0 {
+					t.Fatal("interrupt retained buffered response")
+				}
+			} else {
+				if err != nil || len(mb) != 1 || !bytes.Equal(mb[0].Bytes(), []byte("response")) || mb[0].UDP.Address != original {
+					t.Fatal("close lost response or endpoint")
+				}
+				_, err = reader.ReadMultiBufferTimeout(time.Second)
+				if !errors.Is(err, io.EOF) {
+					t.Fatalf("close did not propagate EOF: %v", err)
+				}
+			}
+		})
+	}
+}
+
+func TestDUIEndpointOverrideReaderPreservesData(t *testing.T) {
+	reader, writer := pipe.New()
+	defer reader.Interrupt()
+	original := net.DomainAddress("original.test")
+	target := net.IPAddress([]byte{127, 0, 0, 1})
+	wrapped := &buf.EndpointOverrideReader{Reader: reader, Dest: target, OriginalDest: original}
+	b := buf.New()
+	b.Write([]byte("request"))
+	b.UDP = &net.Destination{Network: net.Network_UDP, Address: original, Port: 53}
+	if err := writer.WriteMultiBuffer(buf.MultiBuffer{b}); err != nil {
+		t.Fatal(err)
+	}
+	writer.Close()
+	mb, err := wrapped.ReadMultiBuffer()
+	defer buf.ReleaseMulti(mb)
+	if err != nil || len(mb) != 1 || !bytes.Equal(mb[0].Bytes(), []byte("request")) || mb[0].UDP.Address != target {
+		t.Fatal("request endpoint rewrite failed")
+	}
+	_, err = wrapped.ReadMultiBuffer()
+	if !errors.Is(err, io.EOF) {
+		t.Fatalf("EOF lost: %v", err)
+	}
+}
