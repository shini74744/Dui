+++ b/proxy/wireguard/dui_table_linux_test.go
@@ -0,0 +1,37 @@
+//go:build linux
+
+package wireguard
+
+import (
+	"errors"
+	"reflect"
+	"testing"
+)
+
+func TestDUIIPv6TableAllocation(t *testing.T) {
+	var seen []int
+	got, err := findFreeIPv6TableIndex(10230, func(index int) (bool, error) {
+		seen = append(seen, index)
+		return index < 10232, nil
+	})
+	if err != nil || got != 10232 || !reflect.DeepEqual(seen, []int{10230, 10231, 10232}) {
+		t.Fatalf("got %d, %v, candidates %v", got, err, seen)
+	}
+	sentinel := errors.New("netlink denied")
+	calls := 0
+	_, err = findFreeIPv6TableIndex(10230, func(int) (bool, error) {
+		calls++
+		return false, sentinel
+	})
+	if !errors.Is(err, sentinel) || calls != 1 {
+		t.Fatal("netlink failure treated as an available table", err)
+	}
+	calls = 0
+	_, err = findFreeIPv6TableIndex(10230, func(int) (bool, error) {
+		calls++
+		return true, nil
+	})
+	if err == nil || calls != 1024 {
+		t.Fatal("table search is not bounded", calls, err)
+	}
+}
