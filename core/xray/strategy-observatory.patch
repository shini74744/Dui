diff --git a/testing/dui/strategy_observatory_test.go b/testing/dui/strategy_observatory_test.go
new file mode 100644
index 0000000..fe959a5
--- /dev/null
+++ b/testing/dui/strategy_observatory_test.go
@@ -0,0 +1,91 @@
+package dui_test
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/xtls/xray-core/app/observatory"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/features/extension"
+	_ "github.com/xtls/xray-core/main/distro/all"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestDUIFourIndependentProbeRuntimes(t *testing.T) {
+	var mu sync.Mutex
+	counts := map[string]int{}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		counts[r.URL.Path]++
+		mu.Unlock()
+		if r.URL.Path == "/random" {
+			conn, _, err := w.(http.Hijacker).Hijack()
+			if err == nil {
+				conn.Close()
+			}
+		} else {
+			w.WriteHeader(204)
+		}
+	}))
+	defer server.Close()
+	scopes := map[string]any{}
+	for _, name := range []string{"leastPing", "leastLoad", "random", "roundRobin"} {
+		if name == "leastPing" {
+			scopes[name] = map[string]any{"subjectSelector": []string{"shared"}, "probeURL": server.URL + "/" + name, "probeInterval": "50ms", "enableConcurrency": true}
+		} else {
+			scopes[name] = map[string]any{"subjectSelector": []string{"shared"}, "pingConfig": map[string]any{"destination": server.URL + "/" + name, "interval": "10s", "timeout": "1s", "sampling": 1, "connectivity": ""}}
+		}
+	}
+	payload, _ := json.Marshal(map[string]any{"log": map[string]any{"loglevel": "none"}, "outbounds": []any{map[string]any{"tag": "shared", "protocol": "freedom"}}, "strategyObservatory": scopes})
+	instance, err := core.StartInstance("json", payload)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer instance.Close()
+	observer, ok := instance.GetFeature(extension.ObservatoryType()).(extension.StrategyObservatory)
+	if !ok {
+		t.Fatal("scoped observer not registered")
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		ready := true
+		for _, name := range []string{"leastPing", "leastLoad", "random", "roundRobin"} {
+			msg, err := observer.GetObservationForStrategy(context.Background(), name)
+			if err != nil {
+				t.Fatal(err)
+			}
+			status := msg.(*observatory.ObservationResult).Status
+			if len(status) == 0 {
+				ready = false
+				continue
+			}
+			if len(status) != 1 || status[0].OutboundTag != "shared" {
+				t.Fatal(name, status)
+			}
+			if status[0].Alive != (name != "random") {
+				t.Fatalf("results leaked into %s: %v", name, status)
+			}
+		}
+		if ready {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("probes did not complete")
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+	time.Sleep(200 * time.Millisecond)
+	mu.Lock()
+	defer mu.Unlock()
+	for _, name := range []string{"leastPing", "leastLoad", "random", "roundRobin"} {
+		if counts["/"+name] < 1 {
+			t.Fatal(counts)
+		}
+	}
+	if counts["/leastPing"] < 3 {
+		t.Fatal("leastPing schedule did not run independently", counts)
+	}
+}
