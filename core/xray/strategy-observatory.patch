--- /dev/null
+++ b/infra/conf/strategy_observatory.go
@@ -0,0 +1,147 @@
+package conf
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/url"
+	"strings"
+	"time"
+
+	strategyobs "github.com/xtls/xray-core/app/observatory/strategy"
+	"github.com/xtls/xray-core/common/serial"
+	"google.golang.org/protobuf/proto"
+)
+
+// Each key owns a separate observer, including when outbound selectors overlap.
+type StrategyObservatoryConfig map[string]json.RawMessage
+
+func validProbeURL(value string, allowEmpty bool) bool {
+	if value == "" {
+		return allowEmpty
+	}
+	u, err := url.Parse(value)
+	return err == nil && (u.Scheme == "http" || u.Scheme == "https") && u.Host != ""
+}
+func (c StrategyObservatoryConfig) Build(legacy *ObservatoryConfig, burstLegacy *BurstObservatoryConfig, scopes ...map[string][]string) (proto.Message, error) {
+	for name, raw := range c {
+		if name != "leastPing" && name != "leastLoad" && name != "random" && name != "roundRobin" {
+			return nil, fmt.Errorf("unknown probe strategy %q", name)
+		}
+		if len(raw) == 0 || string(raw) == "null" {
+			return nil, fmt.Errorf("missing probe settings for %s", name)
+		}
+	}
+	result := &strategyobs.Config{Observers: map[string]*serial.TypedMessage{}}
+	for _, name := range []string{"leastPing", "leastLoad", "random", "roundRobin"} {
+		raw, explicit := c[name]
+		if !explicit && len(scopes) > 0 && len(scopes[0][name]) == 0 {
+			continue
+		}
+		var msg proto.Message
+		var err error
+		if explicit && name == "leastPing" {
+			var cfg ObservatoryConfig
+			if err = json.Unmarshal(raw, &cfg); err != nil {
+				return nil, err
+			}
+			if time.Duration(cfg.ProbeInterval) <= 0 || !validProbeURL(cfg.ProbeURL, true) {
+				return nil, fmt.Errorf("invalid %s probe URL or interval", name)
+			}
+			msg, err = cfg.Build()
+		} else if explicit {
+			var cfg BurstObservatoryConfig
+			if err = json.Unmarshal(raw, &cfg); err != nil {
+				return nil, err
+			}
+			var fields struct {
+				Ping struct {
+					Destination  string
+					Connectivity string
+					Interval     string
+					Timeout      string
+					Sampling     int
+					HTTPMethod   string
+				} `json:"pingConfig"`
+			}
+			if err = json.Unmarshal(raw, &fields); err != nil {
+				return nil, err
+			}
+			interval, e1 := time.ParseDuration(fields.Ping.Interval)
+			timeout, e2 := time.ParseDuration(fields.Ping.Timeout)
+			if cfg.HealthCheck == nil || e1 != nil || interval < 10*time.Second || e2 != nil || timeout <= 0 || fields.Ping.Sampling < 1 || fields.Ping.Sampling > 1000 || interval > time.Duration(1<<63-1)/time.Duration(fields.Ping.Sampling)/2 || !validProbeURL(fields.Ping.Destination, true) || !validProbeURL(fields.Ping.Connectivity, true) {
+				return nil, fmt.Errorf("invalid %s probe settings", name)
+			}
+			msg, err = cfg.Build()
+		} else if name == "leastPing" && legacy != nil {
+			local := *legacy
+			if len(scopes) > 0 {
+				local.SubjectSelector = probeSelectorIntersection(legacy.SubjectSelector, scopes[0][name])
+			}
+			msg, err = local.Build()
+		} else if burstLegacy != nil {
+			local := *burstLegacy
+			if len(scopes) > 0 {
+				local.SubjectSelector = probeSelectorIntersection(burstLegacy.SubjectSelector, scopes[0][name])
+			}
+			msg, err = local.Build()
+		} else if legacy != nil {
+			local := *legacy
+			if len(scopes) > 0 {
+				local.SubjectSelector = probeSelectorIntersection(legacy.SubjectSelector, scopes[0][name])
+			}
+			msg, err = local.Build()
+		} else {
+			continue
+		}
+		if err != nil {
+			return nil, err
+		}
+		result.Observers[name] = serial.ToTypedMessage(msg)
+	}
+	return result, nil
+}
+
+// Keep legacy selector coverage while isolating active strategy groups.
+func probeSelectorIntersection(legacy, group []string) []string {
+	result := []string{}
+	seen := map[string]bool{}
+	for _, a := range legacy {
+		for _, b := range group {
+			var selected string
+			ok := false
+			if strings.HasPrefix(a, b) {
+				selected = a
+				ok = true
+			} else if strings.HasPrefix(b, a) {
+				selected = b
+				ok = true
+			}
+			if ok && !seen[selected] {
+				seen[selected] = true
+				result = append(result, selected)
+			}
+		}
+	}
+	return result
+}
+func (c *Config) probeStrategySelectors() map[string][]string {
+	result := map[string][]string{}
+	if c.RouterConfig == nil {
+		return result
+	}
+	for _, b := range c.RouterConfig.Balancers {
+		name := strings.ToLower(b.Strategy.Type)
+		switch name {
+		case "", "random":
+			name = "random"
+		case "roundrobin":
+			name = "roundRobin"
+		case "leastload":
+			name = "leastLoad"
+		case "leastping":
+			name = "leastPing"
+		}
+		result[name] = append(result[name], b.Selectors...)
+	}
+	return result
+}
