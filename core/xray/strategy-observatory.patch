+package observatory
+
+import (
+	"context"
+	"sync"
+	"testing"
+)
+
+func TestDUIObservationSnapshot(t *testing.T) {
+	o := &Observer{}
+	o.updateStatusForResult("shared", &ProbeResult{Alive: true, Delay: 7})
+	message, err := o.GetObservation(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	first := message.(*ObservationResult)
+	o.updateStatusForResult("shared", &ProbeResult{Alive: false, LastErrorReason: "failed"})
+	if !first.Status[0].Alive || first.Status[0].Delay != 7 {
+		t.Fatal("later probes changed an earlier observation")
+	}
+	first.Status[0].OutboundTag = "changed-by-reader"
+	message, _ = o.GetObservation(context.Background())
+	if message.(*ObservationResult).Status[0].OutboundTag != "shared" {
+		t.Fatal("reader changed observer state")
+	}
+
+	var workers sync.WaitGroup
+	workers.Add(2)
+	go func() {
+		defer workers.Done()
+		for i := 0; i < 1000; i++ {
+			o.updateStatusForResult("shared", &ProbeResult{Alive: true, Delay: int64(i)})
+		}
+	}()
+	go func() {
+		defer workers.Done()
+		for i := 0; i < 1000; i++ {
+			message, _ := o.GetObservation(context.Background())
+			status := message.(*ObservationResult).Status[0]
+			if status.OutboundTag != "shared" {
+				t.Error("inconsistent snapshot")
+			}
+			_ = status.Delay
+		}
+	}()
+	workers.Wait()
+}
