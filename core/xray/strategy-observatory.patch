+type fake struct {
+	name   string
+	fail   bool
+	events *[]string
+}
+
+func (f *fake) Type() interface{} { return extension.ObservatoryType() }
+func (f *fake) Start() error {
+	*f.events = append(*f.events, "start:"+f.name)
+	if f.fail {
+		return errors.New("start failed")
+	}
+	return nil
+}
+func (f *fake) Close() error { *f.events = append(*f.events, "close:"+f.name); return nil }
+func (f *fake) GetObservation(context.Context) (proto.Message, error) {
+	return &observatory.ObservationResult{Status: []*observatory.OutboundStatus{{OutboundTag: f.name}}}, nil
+}
+func TestDUIObserverLifecycle(t *testing.T) {
+	events := []string{}
+	a := &fake{"a", false, &events}
+	b := &fake{"b", true, &events}
+	o := &Observer{order: []string{"a", "b"}, observers: map[string]extension.Observatory{"a": a, "b": b}}
+	if o.Start() == nil {
+		t.Fatal("failed child accepted")
+	}
+	o.Close()
+	if !reflect.DeepEqual(events, []string{"start:a", "start:b", "close:a"}) {
+		t.Fatal(events)
+	}
+	if _, err := o.GetObservationForStrategy(context.Background(), "missing"); err == nil {
+		t.Fatal("missing scope")
+	}
+}
