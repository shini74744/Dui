new file mode 100644
index 0000000..5e4674d
--- /dev/null
+++ b/app/observatory/strategy/observer.go
@@ -0,0 +1,98 @@
+// Package strategy isolates probe schedules and measurements by balancing strategy.
+package strategy
+
+import (
+	"context"
+	"fmt"
+	"sort"
+
+	"github.com/xtls/xray-core/app/observatory"
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/features/extension"
+	"google.golang.org/protobuf/proto"
+)
+
+type Observer struct {
+	observers map[string]extension.Observatory
+	order     []string
+	started   []extension.Observatory
+}
+
+func (o *Observer) Type() interface{} { return extension.ObservatoryType() }
+func (o *Observer) GetObservationForStrategy(ctx context.Context, name string) (proto.Message, error) {
+	child := o.observers[name]
+	if child == nil {
+		return nil, fmt.Errorf("no observatory configured for strategy %q", name)
+	}
+	return child.GetObservation(ctx)
+}
+
+// The legacy API returns a deterministic union; routing always asks for its own strategy.
+func (o *Observer) GetObservation(ctx context.Context) (proto.Message, error) {
+	result := &observatory.ObservationResult{}
+	seen := map[string]bool{}
+	for _, name := range o.order {
+		msg, err := o.GetObservationForStrategy(ctx, name)
+		if err != nil {
+			return nil, err
+		}
+		if report, ok := msg.(*observatory.ObservationResult); ok {
+			for _, status := range report.Status {
+				if !seen[status.OutboundTag] {
+					seen[status.OutboundTag] = true
+					result.Status = append(result.Status, status)
+				}
+			}
+		}
+	}
+	return result, nil
+}
+func (o *Observer) Start() error {
+	for _, name := range o.order {
+		child := o.observers[name]
+		if err := child.Start(); err != nil {
+			_ = o.Close()
+			return err
+		}
+		o.started = append(o.started, child)
+	}
+	return nil
+}
+func (o *Observer) Close() error {
+	var first error
+	for i := len(o.started) - 1; i >= 0; i-- {
+		if err := o.started[i].Close(); err != nil && first == nil {
+			first = err
+		}
+	}
+	o.started = nil
+	return first
+}
+func New(ctx context.Context, config *Config) (*Observer, error) {
+	o := &Observer{observers: map[string]extension.Observatory{}}
+	for name := range config.Observers {
+		o.order = append(o.order, name)
+	}
+	sort.Strings(o.order)
+	for _, name := range o.order {
+		msg, err := config.Observers[name].GetInstance()
+		if err != nil {
+			return nil, err
+		}
+		child, err := common.CreateObject(ctx, msg)
+		if err != nil {
+			return nil, err
+		}
+		observer, ok := child.(extension.Observatory)
+		if !ok {
+			return nil, fmt.Errorf("invalid strategy observatory %q", name)
+		}
+		o.observers[name] = observer
+	}
+	return o, nil
+}
+func init() {
+	common.Must(common.RegisterConfig((*Config)(nil), func(ctx context.Context, config interface{}) (interface{}, error) {
+		return New(ctx, config.(*Config))
+	}))
+}
