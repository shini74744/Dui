+package conf
+
+import (
+	"encoding/json"
+	"github.com/xtls/xray-core/app/observatory/burst"
+	strategyobs "github.com/xtls/xray-core/app/observatory/strategy"
+	"testing"
+)
+
+func TestDUIStrategyProbeConfig(t *testing.T) {
+	good := []byte("{\"subjectSelector\":[\"shared\"],\"pingConfig\":{\"interval\":\"12s\",\"timeout\":\"3s\",\"sampling\":4,\"connectivity\":\"\"}}")
+	cfg := StrategyObservatoryConfig{"random": good, "roundRobin": good, "leastLoad": good}
+	msg, err := cfg.Build(&ObservatoryConfig{SubjectSelector: []string{"legacy"}}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	out := msg.(*strategyobs.Config)
+	if len(out.Observers) != 4 {
+		t.Fatal(out)
+	}
+	random, _ := out.Observers["random"].GetInstance()
+	round, _ := out.Observers["roundRobin"].GetInstance()
+	if random == round || random.(*burst.Config).PingConfig.Interval != 12000000000 {
+		t.Fatal(random, round)
+	}
+	for _, bad := range []string{
+		"null", "[]", "{}", "{\"pingConfig\":{\"interval\":\"1s\",\"timeout\":\"3s\",\"sampling\":2}}",
+		"{\"pingConfig\":{\"interval\":\"10s\",\"timeout\":\"3s\",\"sampling\":0}}",
+		"{\"pingConfig\":{\"interval\":\"10s\",\"timeout\":\"3s\",\"sampling\":1.5}}",
+		"{\"pingConfig\":{\"interval\":\"2000000h\",\"timeout\":\"3s\",\"sampling\":1000}}",
+	} {
+		_, err := (StrategyObservatoryConfig{"random": json.RawMessage(bad)}).Build(nil, nil)
+		if err == nil {
+			t.Fatalf("accepted %s", bad)
+		}
+	}
+	if _, err := (StrategyObservatoryConfig{"unknown": good}).Build(nil, nil); err == nil {
+		t.Fatal("unknown strategy accepted")
+	}
+	if _, err := (StrategyObservatoryConfig{"leastPing": json.RawMessage("{\"probeInterval\":\"-1s\"}")}).Build(nil, nil); err == nil {
+		t.Fatal("negative interval")
+	}
+}
