@@ -0,0 +1,14 @@
+package router
+
+import (
+	"context"
+	"github.com/xtls/xray-core/features/extension"
+	"google.golang.org/protobuf/proto"
+)
+
+func strategyObservation(ctx context.Context, observer extension.Observatory, name string) (proto.Message, error) {
+	if scoped, ok := observer.(extension.StrategyObservatory); ok {
+		return scoped.GetObservationForStrategy(ctx, name)
+	}
+	return observer.GetObservation(ctx)
+}
