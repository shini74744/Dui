+package router
+
+import (
+	"context"
+	"github.com/xtls/xray-core/app/observatory"
+	"github.com/xtls/xray-core/features/extension"
+	"google.golang.org/protobuf/proto"
+	"testing"
+)
+
+type duiScopedObserver struct{ seen []string }
+
+func (o *duiScopedObserver) Type() interface{} { return extension.ObservatoryType() }
+func (o *duiScopedObserver) Start() error      { return nil }
+func (o *duiScopedObserver) Close() error      { return nil }
+func (o *duiScopedObserver) GetObservation(context.Context) (proto.Message, error) {
+	return &observatory.ObservationResult{Status: []*observatory.OutboundStatus{{OutboundTag: "wrong", Alive: true, Delay: 1}}}, nil
+}
+func (o *duiScopedObserver) GetObservationForStrategy(_ context.Context, name string) (proto.Message, error) {
+	o.seen = append(o.seen, name)
+	return &observatory.ObservationResult{Status: []*observatory.OutboundStatus{
+		{OutboundTag: name, Alive: true, Delay: 10, HealthPing: &observatory.HealthPingMeasurementResult{All: 2, Average: 10000000, Deviation: 1000000}},
+		{OutboundTag: "wrong", Alive: false, Delay: 1},
+	}}, nil
+}
+func TestDUIStrategyObservationsAreIsolated(t *testing.T) {
+	ctx := context.Background()
+	observer := &duiScopedObserver{}
+	least := NewLeastLoadStrategy(&StrategyLeastLoadConfig{Expected: 1})
+	least.observer = observer
+	least.ctx = ctx
+	strategies := map[string]BalancingStrategy{
+		"leastPing":  &LeastPingStrategy{ctx: ctx, observatory: observer},
+		"leastLoad":  least,
+		"roundRobin": &RoundRobinStrategy{ctx: ctx, observatory: observer},
+		"random":     &RandomStrategy{ctx: ctx, observatory: observer},
+	}
+	for name, strategy := range strategies {
+		for i := 0; i < 20; i++ {
+			if got := strategy.PickOutbound([]string{name, "wrong"}); got != name {
+				t.Fatalf("%s selected %s", name, got)
+			}
+		}
+	}
+	if len(observer.seen) != 80 {
+		t.Fatal(observer.seen)
+	}
+}
+
+type duiLegacyObserver struct{ duiScopedObserver }
+
+func (o *duiLegacyObserver) GetObservation(ctx context.Context) (proto.Message, error) {
+	return o.duiScopedObserver.GetObservation(ctx)
+}
+
+// A wrapper deliberately exposes only the legacy interface.
+type duiLegacyOnly struct{ extension.Observatory }
+
+func TestDUILegacyObservatoryStillWorks(t *testing.T) {
+	o := &duiScopedObserver{}
+	msg, err := strategyObservation(context.Background(), &duiLegacyOnly{o}, "random")
+	if err != nil || msg.(*observatory.ObservationResult).Status[0].OutboundTag != "wrong" || len(o.seen) != 0 {
+		t.Fatal(msg, err, o.seen)
+	}
+}
