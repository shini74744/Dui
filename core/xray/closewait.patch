+package duiclosewait
+
+import (
+	"syscall"
+
+	"golang.org/x/sys/unix"
+)
+
+func isCloseWait(raw syscall.RawConn) (bool, error) {
+	var waiting bool
+	var probeErr error
+	err := raw.Control(func(fd uintptr) {
+		info, err := unix.GetsockoptTCPInfo(int(fd), unix.IPPROTO_TCP, unix.TCP_INFO)
+		probeErr = err
+		// Linux TCP_CLOSE_WAIT from enum tcp_state (not exported by x/sys).
+		if err == nil {
+			waiting = info.State == 8
+		}
+	})
+	if err != nil {
+		return false, err
+	}
+	return waiting, probeErr
+}
