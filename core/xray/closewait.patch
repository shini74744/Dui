+//go:build linux
+
+package internet
+
+import (
+	"context"
+	"io"
+	stdnet "net"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/duiclosewait"
+	"github.com/xtls/xray-core/common/net"
+)
+
+func TestDUICloseWaitSystemListenerAndDialer(t *testing.T) {
+	for _, outbound := range []bool{false, true} {
+		t.Run(map[bool]string{false: "inbound", true: "outbound"}[outbound], func(t *testing.T) {
+			guard := duiclosewait.New()
+			if err := guard.Configure(1); err != nil {
+				t.Fatal(err)
+			}
+			defer guard.Close()
+			ctx := duiclosewait.WithContext(context.Background(), guard)
+			listenerCtx := ctx
+			if outbound {
+				listenerCtx = context.Background()
+			}
+			l, err := (&DefaultListener{}).Listen(listenerCtx, &net.TCPAddr{IP: stdnet.IPv4(127, 0, 0, 1)}, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer l.Close()
+			var client stdnet.Conn
+			if outbound {
+				client, err = (&DefaultSystemDialer{}).Dial(ctx, nil, net.TCPDestination(net.LocalHostIP, net.Port(l.Addr().(*net.TCPAddr).Port)), nil)
+			} else {
+				client, err = stdnet.Dial("tcp", l.Addr().String())
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer client.Close()
+			server, err := l.Accept()
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer server.Close()
+			peer := client
+			if outbound {
+				peer = server
+			}
+			if err := peer.(*stdnet.TCPConn).CloseWrite(); err != nil {
+				t.Fatal(err)
+			}
+			peer.SetReadDeadline(time.Now().Add(4 * time.Second))
+			b := make([]byte, 1)
+			if _, err := peer.Read(b); err != io.EOF {
+				t.Fatalf("actual %v socket did not expire: %v", outbound, err)
+			}
+		})
+	}
+}
