+)
+
+type duiGuardProbe struct{}
+
+func init() {
+	common.Must(common.RegisterConfig((*duiGuardProbe)(nil), func(ctx context.Context, _ interface{}) (interface{}, error) {
+		return ctx, nil
+	}))
+}
+
+func TestDUICloseWaitJSONInstanceAndDetachedContext(t *testing.T) {
+	var previous *duiclosewait.Guard
+	for _, enabled := range []bool{true, false} {
+		config := `{"log":{"loglevel":"none"},"outbounds":[{"protocol":"freedom"}]}`
+		if enabled {
+			config = `{"log":{"loglevel":"none"},"policy":{"system":{"duiCloseWaitTimeout":30}},"outbounds":[{"protocol":"freedom"}]}`
+		}
+		cfg, err := core.LoadConfig("json", bytes.NewBufferString(config))
+		if err != nil {
+			t.Fatal(err)
+		}
+		instance, err := core.New(cfg)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer instance.Close()
+		// API hot additions also create their objects through CreateObject.
+		obj, err := core.CreateObject(instance, &duiGuardProbe{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		ctx := obj.(context.Context)
+		guard := duiclosewait.FromContext(ctx)
+		if guard == nil || guard.Enabled() != enabled {
+			t.Fatalf("JSON policy did not configure this instance: enabled=%v", enabled)
+		}
+		if previous == guard {
+			t.Fatal("different instances shared a guard")
+		}
+		previous = guard
+		detached := core.ToBackgroundDetachedContext(ctx)
+		if duiclosewait.FromContext(detached) != guard {
+			t.Fatal("detached dial context lost guard")
+		}
+		if core.FromContext(detached) != instance {
+			t.Fatal("detached context lost instance")
+		}
+	}
+}
