+package duiclosewait
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"testing"
+	"time"
+)
+
+func tcpPair(t *testing.T) (*net.TCPConn, *net.TCPConn) {
+	t.Helper()
+	l, err := net.ListenTCP("tcp4", &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer l.Close()
+	client, err := net.DialTCP("tcp4", nil, l.Addr().(*net.TCPAddr))
+	if err != nil {
+		t.Fatal(err)
+	}
+	server, err := l.AcceptTCP()
+	if err != nil {
+		client.Close()
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { client.Close(); server.Close() })
+	return client, server
+}
+
+func waitForCloseWait(t *testing.T, c *net.TCPConn) {
+	t.Helper()
+	raw, err := c.SyscallConn()
+	if err != nil {
+		t.Fatal(err)
+	}
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		v, err := isCloseWait(raw)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if v {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatal("socket did not enter CLOSE-WAIT")
+}
+
+func manualGuard(t *testing.T, seconds int32) *Guard {
+	t.Helper()
+	g := New()
+	g.interval = time.Hour
+	if err := g.Configure(seconds); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(g.Close)
+	return g
+}
+
+func TestUnconsumedFINExpiresAtDeadline(t *testing.T) {
+	client, server := tcpPair(t)
+	g := manualGuard(t, 3)
+	if err := g.Track(server); err != nil {
+		t.Fatal(err)
+	}
+	// Deliberately leave payload unread: application EOF detection cannot help.
+	if _, err := client.Write([]byte("unread payload")); err != nil {
+		t.Fatal(err)
+	}
+	if err := client.CloseWrite(); err != nil {
+		t.Fatal(err)
+	}
+	waitForCloseWait(t, server)
+	now := time.Now()
+	g.scan(now)
+	g.scan(now.Add(2 * time.Second))
+	if _, err := server.Write([]byte("response")); err != nil {
+		t.Fatalf("closed too early: %v", err)
+	}
+	buf := make([]byte, 8)
+	client.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err := io.ReadFull(client, buf); err != nil || string(buf) != "response" {
+		t.Fatalf("half-close response failed: %q %v", buf, err)
+	}
+	// Outgoing traffic must not reset a CLOSE-WAIT maximum lifetime.
+	g.scan(now.Add(3 * time.Second))
+	if _, err := server.Write([]byte("late")); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("expected closed socket, got %v", err)
+	}
+	g.mu.Lock()
+	remaining := len(g.connections)
+	g.mu.Unlock()
+	if remaining != 0 {
+		t.Fatalf("expired connection retained: %d", remaining)
+	}
+}
+
+func TestEstablishedDisabledAndNormalClose(t *testing.T) {
+	client, server := tcpPair(t)
+	g := manualGuard(t, 1)
+	if err := g.Track(server); err != nil {
+		t.Fatal(err)
+	}
+	now := time.Now()
+	g.scan(now)
+	g.scan(now.Add(time.Hour))
+	if _, err := server.Write([]byte("a")); err != nil {
+		t.Fatalf("ESTABLISHED closed: %v", err)
+	}
+	client.SetReadDeadline(time.Now().Add(time.Second))
+	b := make([]byte, 1)
+	if _, err := io.ReadFull(client, b); err != nil {
+		t.Fatal(err)
+	}
+	server.Close()
+	g.scan(now.Add(2 * time.Hour))
+	g.mu.Lock()
+	remaining := len(g.connections)
+	g.mu.Unlock()
+	if remaining != 0 {
+		t.Fatal("normal close retained connection")
+	}
+	c2, s2 := tcpPair(t)
+	disabled := manualGuard(t, 0)
+	if err := disabled.Track(s2); err != nil {
+		t.Fatal(err)
+	}
+	c2.CloseWrite()
+	waitForCloseWait(t, s2)
+	disabled.scan(now)
+	disabled.scan(now.Add(time.Hour))
+	if _, err := s2.Write([]byte("b")); err != nil {
+		t.Fatalf("disabled guard closed connection: %v", err)
+	}
+	if disabled.done != nil {
+		t.Fatal("disabled guard started scanner")
+	}
+}
+
+func TestPeriodicScannerAndCoreIsolation(t *testing.T) {
+	c1, s1 := tcpPair(t)
+	c2, s2 := tcpPair(t)
+	g := New()
+	g.interval = 10 * time.Millisecond
+	if err := g.Configure(1); err != nil {
+		t.Fatal(err)
+	}
+	defer g.Close()
+	ctx := WithContext(context.Background(), g)
+	if err := Watch(ctx, s1); err != nil {
+		t.Fatal(err)
+	}
+	if err := Watch(context.Background(), s2); err != nil {
+		t.Fatal(err)
+	}
+	c1.CloseWrite()
+	c2.CloseWrite()
+	c1.SetReadDeadline(time.Now().Add(3 * time.Second))
+	b := make([]byte, 1)
+	if _, err := c1.Read(b); err != io.EOF {
+		t.Fatalf("scanner did not close: %v", err)
+	}
+	if _, err := s2.Write([]byte("x")); err != nil {
+		t.Fatalf("unrelated core affected: %v", err)
+	}
+}
+
+func TestConcurrentCloseAndTracking(t *testing.T) {
+	g := manualGuard(t, 30)
+	var wg sync.WaitGroup
+	for i := 0; i < 30; i++ {
+		_, server := tcpPair(t)
+		wg.Add(1)
+		go func(c *net.TCPConn) { defer wg.Done(); _ = g.Track(c); _ = c.Close(); g.scan(time.Now()) }(server)
+	}
+	wg.Add(1)
+	go func() { defer wg.Done(); g.Close() }()
+	wg.Wait()
+	g.Close()
+	g.mu.Lock()
+	remaining := len(g.connections)
+	g.mu.Unlock()
+	if remaining != 0 {
+		t.Fatal("shutdown retained sockets")
+	}
+}
+
+func TestGuardValidationAndNonTCP(t *testing.T) {
+	g := New()
+	defer g.Close()
+	if g.Configure(-1) == nil || g.Configure(601) == nil {
+		t.Fatal("accepted invalid timeout")
+	}
+	if err := g.Configure(60); err != nil {
+		t.Fatal(err)
+	}
+	a, b := net.Pipe()
+	defer a.Close()
+	defer b.Close()
+	if err := g.Track(a); err != nil {
+		t.Fatal(err)
+	}
+	if g.done != nil {
+		t.Fatal("tracked non-TCP connection")
+	}
+}
