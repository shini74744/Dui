+// Package duiclosewait bounds the lifetime of native TCP sockets in CLOSE-WAIT.
+// It observes kernel state independently of application reads and never changes
+// system-wide TCP settings. Each core instance owns one optional scanner.
+package duiclosewait
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"runtime"
+	"sync"
+	"syscall"
+	"time"
+)
+
+type contextKey struct{}
+
+type entry struct {
+	raw   syscall.RawConn
+	since time.Time
+}
+
+type Guard struct {
+	mu          sync.Mutex
+	timeout     time.Duration
+	interval    time.Duration
+	connections map[*net.TCPConn]*entry
+	stop        chan struct{}
+	done        chan struct{}
+	closed      bool
+}
+
+func New() *Guard {
+	return &Guard{interval: time.Second, connections: make(map[*net.TCPConn]*entry)}
+}
+
+func WithContext(ctx context.Context, g *Guard) context.Context {
+	return context.WithValue(ctx, contextKey{}, g)
+}
+
+func FromContext(ctx context.Context) *Guard {
+	g, _ := ctx.Value(contextKey{}).(*Guard)
+	return g
+}
+
+func Validate(seconds int32) error {
+	if seconds < 0 || seconds > 600 {
+		return fmt.Errorf("duiCloseWaitTimeout must be 0-600 seconds")
+	}
+	if seconds > 0 && runtime.GOOS != "linux" {
+		return fmt.Errorf("duiCloseWaitTimeout requires Linux TCP_INFO")
+	}
+	return nil
+}
+
+// Configure is called while constructing the core, before any listener starts.
+func (g *Guard) Configure(seconds int32) error {
+	if err := Validate(seconds); err != nil {
+		return err
+	}
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.closed || g.done != nil {
+		return fmt.Errorf("CLOSE-WAIT guard already started or closed")
+	}
+	g.timeout = time.Duration(seconds) * time.Second
+	return nil
+}
+
+func (g *Guard) Enabled() bool {
+	if g == nil {
+		return false
+	}
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	return g.timeout > 0 && !g.closed
+}
+
+// Track keeps the original *net.TCPConn, preserving splice, SyscallConn and
+// CloseWrite. RawConn.Control protects the descriptor against concurrent close
+// and reuse; the descriptor number is never saved or closed directly.
+func (g *Guard) Track(conn net.Conn) error {
+	if g == nil {
+		return nil
+	}
+	tcp, ok := conn.(*net.TCPConn)
+	if !ok {
+		return nil
+	}
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.closed {
+		return net.ErrClosed
+	}
+	if g.timeout == 0 {
+		return nil
+	}
+	if _, exists := g.connections[tcp]; exists {
+		return nil
+	}
+	raw, err := tcp.SyscallConn()
+	if err != nil {
+		return err
+	}
+	if _, err = isCloseWait(raw); err != nil {
+		return fmt.Errorf("CLOSE-WAIT state check: %w", err)
+	}
+	g.connections[tcp] = &entry{raw: raw}
+	if g.done == nil {
+		g.stop = make(chan struct{})
+		g.done = make(chan struct{})
+		go g.run()
+	}
+	return nil
+}
+
+func Watch(ctx context.Context, conn net.Conn) error {
+	return FromContext(ctx).Track(conn)
+}
+
+func (g *Guard) run() {
+	defer close(g.done)
+	ticker := time.NewTicker(g.interval)
+	defer ticker.Stop()
+	for {
+		select {
+		case now := <-ticker.C:
+			g.scan(now)
+		case <-g.stop:
+			return
+		}
+	}
+}
+
+func (g *Guard) scan(now time.Time) {
+	var expired []*net.TCPConn
+	g.mu.Lock()
+	for conn, e := range g.connections {
+		waiting, err := isCloseWait(e.raw)
+		if err != nil {
+			delete(g.connections, conn)
+			continue
+		}
+		if !waiting {
+			e.since = time.Time{}
+			continue
+		}
+		if e.since.IsZero() {
+			e.since = now
+			continue
+		}
+		if now.Sub(e.since) >= g.timeout {
+			delete(g.connections, conn)
+			expired = append(expired, conn)
+		}
+	}
+	g.mu.Unlock()
+	for _, conn := range expired {
+		_ = conn.Close()
+	}
+}
+
+func (g *Guard) Close() {
+	if g == nil {
+		return
+	}
+	g.mu.Lock()
+	if g.closed {
+		g.mu.Unlock()
+		return
+	}
+	g.closed = true
+	done := g.done
+	if done != nil {
+		close(g.stop)
+	}
+	connections := g.connections
+	g.connections = make(map[*net.TCPConn]*entry)
+	g.mu.Unlock()
+	for conn := range connections {
+		_ = conn.Close()
+	}
+	if done != nil {
+		<-done
+	}
+}
+
+type listener struct {
+	net.Listener
+	guard *Guard
+}
+
+func WrapListener(ctx context.Context, l net.Listener) net.Listener {
+	g := FromContext(ctx)
+	if !g.Enabled() {
+		return l
+	}
+	return &listener{Listener: l, guard: g}
+}
+
+func (l *listener) Accept() (net.Conn, error) {
+	conn, err := l.Listener.Accept()
+	if err != nil {
+		return nil, err
+	}
+	if err := l.guard.Track(conn); err != nil {
+		_ = conn.Close()
+		return nil, err
+	}
+	return conn, nil
+}
