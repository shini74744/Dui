+package conf_test
+
+import (
+	"encoding/json"
+	"github.com/xtls/xray-core/infra/conf"
+	"google.golang.org/protobuf/proto"
+	"runtime"
+	"testing"
+)
+
+func TestDUICloseWaitPolicyBuild(t *testing.T) {
+	for _, value := range []string{"-1", "601", "1.5"} {
+		var p conf.SystemPolicy
+		err := json.Unmarshal([]byte(`{"duiCloseWaitTimeout":`+value+`}`), &p)
+		if err == nil {
+			_, err = p.Build()
+		}
+		if err == nil {
+			t.Fatalf("accepted %s", value)
+		}
+	}
+	p := conf.SystemPolicy{DUICloseWaitTimeout: 30, StatsInboundUplink: true}
+	built, err := p.Build()
+	if runtime.GOOS != "linux" {
+		if err == nil {
+			t.Fatal("unsupported platform accepted")
+		}
+		return
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw, err := proto.Marshal(built)
+	if err != nil {
+		t.Fatal(err)
+	}
+	copy := proto.Clone(built)
+	proto.Reset(copy)
+	if err := proto.Unmarshal(raw, copy); err != nil {
+		t.Fatal(err)
+	}
+	if !proto.Equal(built, copy) || built.DuiCloseWaitTimeout != 30 {
+		t.Fatal("protobuf dropped timeout")
+	}
+}
