+package conf
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+)
+
+type priorityLevel struct {
+	Selectors StringList     `json:"selector"`
+	Strategy  StrategyConfig `json:"strategy"`
+}
+
+func (r *BalancingRule) priorityLevels() ([]priorityLevel, error) {
+	if r.FallbackTag != "" {
+		return nil, fmt.Errorf("priority balancer must use explicit levels instead of fallbackTag")
+	}
+	if r.Strategy.Settings == nil {
+		return nil, fmt.Errorf("priority balancer requires levels")
+	}
+	var settings struct {
+		Levels []priorityLevel `json:"levels"`
+	}
+	if err := json.Unmarshal(*r.Strategy.Settings, &settings); err != nil {
+		return nil, err
+	}
+	if len(settings.Levels) < 1 || len(settings.Levels) > 10 {
+		return nil, fmt.Errorf("priority balancer requires 1 to 10 levels")
+	}
+	for i, l := range settings.Levels {
+		if len(l.Selectors) == 0 {
+			return nil, fmt.Errorf("priority level %d has no outbounds", i+1)
+		}
+		for _, tag := range l.Selectors {
+			if strings.TrimSpace(tag) == "" {
+				return nil, fmt.Errorf("empty priority outbound tag")
+			}
+		}
+		switch strings.ToLower(l.Strategy.Type) {
+		case "", "random", "roundrobin", "leastping", "leastload":
+		default:
+			return nil, fmt.Errorf("invalid priority level strategy")
+		}
+	}
+	return settings.Levels, nil
+}
