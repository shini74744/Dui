+)
+
+type sharingManager struct{ outbound.Manager }
+
+func (*sharingManager) Type() interface{} { return outbound.ManagerType() }
+func (*sharingManager) Start() error      { return nil }
+func (*sharingManager) Close() error      { return nil }
+
+type sharingDispatcher struct {
+	routing.Dispatcher
+	address string
+}
+
+func (*sharingDispatcher) Type() interface{} { return routing.DispatcherType() }
+func (*sharingDispatcher) Start() error      { return nil }
+func (*sharingDispatcher) Close() error      { return nil }
+func (d *sharingDispatcher) Dispatch(ctx context.Context, _ cn.Destination) (*transport.Link, error) {
+	conn, err := (&net.Dialer{}).DialContext(ctx, "tcp", d.address)
+	if err != nil {
+		return nil, err
+	}
+	return &transport.Link{Reader: buf.NewReader(conn), Writer: buf.NewWriter(conn)}, nil
+}
+func TestDUISharedProbeNetworkAndHistory(t *testing.T) {
+	var requests atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { requests.Add(1); w.WriteHeader(204) }))
+	defer server.Close()
+	instance := new(core.Instance)
+	ctx := context.WithValue(context.Background(), core.XrayKey(1), instance)
+	rec := duiprobehistory.New()
+	ctx = duiprobehistory.WithRecorder(ctx, rec)
+	if err := instance.AddFeature(&sharingManager{}); err != nil {
+		t.Fatal(err)
+	}
+	dispatcher := &sharingDispatcher{address: server.Listener.Addr().String()}
+	if err := instance.AddFeature(dispatcher); err != nil {
+		t.Fatal(err)
+	}
+	config := func(exact bool, interval time.Duration) *burst.Config {
+		return &burst.Config{SubjectSelector: []string{"a"}, ExactSelector: exact, PingConfig: &burst.HealthPingConfig{Destination: server.URL, Interval: int64(interval), SamplingCount: 1, Timeout: int64(time.Second)}}
+	}
+	o, err := New(ctx, &Config{Observers: map[string]*serial.TypedMessage{
+		"outbound":   serial.ToTypedMessage(config(true, 0)),
+		"roundRobin": serial.ToTypedMessage(config(false, time.Minute)),
+		"random":     serial.ToTypedMessage(config(false, 2*time.Minute)),
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if o.observers["outbound"] != o.observers["roundRobin"] {
+		t.Fatal("identical settings did not share")
+	}
+	if o.observers["outbound"] == o.observers["random"] {
+		t.Fatal("different schedules were merged")
+	}
+	// Force one real HTTP measurement without starting periodic schedulers.
+	o.observers["outbound"].(*burst.Observer).Check([]string{"a"})
+	if requests.Load() != 1 {
+		t.Fatalf("physical requests %d", requests.Load())
+	}
+	for _, scope := range []string{"outbound", "roundRobin"} {
+		msg, err := o.GetObservationForStrategy(ctx, scope)
+		if err != nil || len(msg.(*observatory.ObservationResult).Status) != 1 || !msg.(*observatory.ObservationResult).Status[0].Alive {
+			t.Fatalf("scope %s did not reuse successful result", scope)
+		}
+	}
+	msg, _ := o.GetObservationForStrategy(ctx, "random")
+	if len(msg.(*observatory.ObservationResult).Status) != 0 {
+		t.Fatal("different schedule inherited a result")
+	}
+	history := rec.Read("", 0, 20)
+	if len(history.Events) != 2 || history.Events[0].Time != history.Events[1].Time {
+		t.Fatal("shared history should record one result in both scopes", history)
+	}
+	server.Close()
+	o.observers["outbound"].(*burst.Observer).Check([]string{"a"})
+	msg, _ = o.GetObservationForStrategy(ctx, "outbound")
+	if msg.(*observatory.ObservationResult).Status[0].Alive {
+		t.Fatal("closed endpoint remained healthy")
+	}
+	restored := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(204) }))
+	defer restored.Close()
+	dispatcher.address = restored.Listener.Addr().String()
+	o.observers["outbound"].(*burst.Observer).Check([]string{"a"})
+	msg, _ = o.GetObservationForStrategy(ctx, "outbound")
+	if !msg.(*observatory.ObservationResult).Status[0].Alive {
+		t.Fatal("recovery did not update shared measurement")
+	}
+	// Exact route selector must not inherit another prefix-matched tag.
+	o.observers["roundRobin"].(*burst.Observer).Check([]string{"ab"})
+	msg, _ = o.GetObservationForStrategy(ctx, "outbound")
+	if len(msg.(*observatory.ObservationResult).Status) != 1 {
+		t.Fatal("exact standalone selector leaked prefix neighbor")
+	}
+}
+func TestDUISharedObserverStartsAndClosesOnce(t *testing.T) {
+	events := []string{}
+	f := &fake{"a", false, &events}
+	o := &Observer{order: []string{"outbound", "roundRobin"}, observers: map[string]extension.Observatory{"outbound": f, "roundRobin": f}}
+	if err := o.Start(); err != nil {
+		t.Fatal(err)
+	}
+	o.Close()
+	if len(events) != 2 {
+		t.Fatal(events)
+	}
+}
