+package conf
+
+import (
+	"encoding/json"
+	"fmt"
+	"github.com/xtls/xray-core/app/router"
+	"strings"
+)
+
+func (c *Config) configureOutboundHealth(config *router.Config) error {
+	eligible := map[string]bool{}
+	for _, outbound := range c.OutboundConfigs {
+		p := strings.ToLower(outbound.Protocol)
+		eligible[outbound.Tag] = outbound.Tag != "" && outbound.Tag != "api" &&
+			!strings.HasPrefix(outbound.Tag, "__dui_blacklist_") &&
+			p != "blackhole" && p != "dns" && p != "loopback"
+	}
+	selected := map[string]bool{}
+	raw, enabled := c.StrategyObservatory["outbound"]
+	if enabled {
+		var probe BurstObservatoryConfig
+		if err := json.Unmarshal(raw, &probe); err != nil {
+			return err
+		}
+		for _, tag := range probe.SubjectSelector {
+			if !eligible[tag] {
+				return fmt.Errorf("standalone probe selector is not a probeable outbound")
+			}
+			selected[tag] = true
+		}
+	}
+	for _, rule := range config.Rule {
+		rule.OutboundHealthCheck = selected[rule.GetTag()] && rule.GetBalancingTag() == ""
+		if rule.FallbackTag != "" && (!rule.OutboundHealthCheck || !selected[rule.FallbackTag] || rule.FallbackTag == rule.GetTag()) {
+			return fmt.Errorf("route fallback requires both primary and backup in strategyObservatory.outbound")
+		}
+	}
+
+	for _, balancer := range config.BalancingRule {
+		for _, level := range balancer.PriorityLevels {
+			scope := map[string]string{"random": "random", "roundrobin": "roundRobin", "leastping": "leastPing", "leastload": "leastLoad"}[level.Strategy]
+			raw, ok := c.StrategyObservatory[scope]
+			if !ok {
+				return fmt.Errorf("priority levels require independent %s probing", scope)
+			}
+			var probe struct{ SubjectSelector []string }
+			if err := json.Unmarshal(raw, &probe); err != nil {
+				return err
+			}
+			for _, tag := range level.OutboundSelector {
+				if !eligible[tag] {
+					return fmt.Errorf("priority selector is not a probeable outbound")
+				}
+				covered := false
+				for _, prefix := range probe.SubjectSelector {
+					if strings.HasPrefix(tag, prefix) {
+						covered = true
+						break
+					}
+				}
+				if !covered {
+					return fmt.Errorf("priority outbound is not covered by its strategy probe")
+				}
+			}
+		}
+	}
+	return nil
+}
