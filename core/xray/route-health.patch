+	"github.com/xtls/xray-core/features/outbound"
+	"github.com/xtls/xray-core/features/routing"
+	"google.golang.org/protobuf/proto"
+	"testing"
+)
+
+type healthTestObserver struct {
+	states map[string]map[string]bool
+	fail   bool
+}
+
+func (o *healthTestObserver) Type() interface{} { return extension.ObservatoryType() }
+func (o *healthTestObserver) Start() error      { return nil }
+func (o *healthTestObserver) Close() error      { return nil }
+func (o *healthTestObserver) GetObservation(context.Context) (proto.Message, error) {
+	panic("cross-scope union must never be used")
+}
+func (o *healthTestObserver) GetObservationForStrategy(_ context.Context, scope string) (proto.Message, error) {
+	if o.fail {
+		return nil, errors.New("unavailable")
+	}
+	report := &observatory.ObservationResult{}
+	for tag, alive := range o.states[scope] {
+		report.Status = append(report.Status, &observatory.OutboundStatus{OutboundTag: tag, Alive: alive, Delay: 10, HealthPing: &observatory.HealthPingMeasurementResult{All: 2, Average: 10000000, Deviation: 1000000}})
+	}
+	return report, nil
+}
+
+type healthTestHandler struct{ outbound.Handler }
+type healthTestManager struct {
+	outbound.Manager
+	tags map[string]bool
+}
+
+func (m *healthTestManager) GetHandler(tag string) outbound.Handler {
+	if m.tags[tag] {
+		return &healthTestHandler{}
+	}
+	return nil
+}
+func healthFixture() (context.Context, *core.Instance, *healthTestManager, *healthTestObserver) {
+	instance := new(core.Instance)
+	ctx := context.WithValue(context.Background(), core.XrayKey(1), instance)
+	manager := &healthTestManager{tags: map[string]bool{"a": true, "ab": true, "b": true, "c": true, "d": true, "direct": true}}
+	observer := &healthTestObserver{states: map[string]map[string]bool{}}
+	return ctx, instance, manager, observer
+}
+func TestDUIStandaloneFallbackAndRecovery(t *testing.T) {
+	for _, backup := range []string{"", "b"} {
+		t.Run(backup, func(t *testing.T) {
+			ctx, instance, manager, obs := healthFixture()
+			h := &outboundHealth{primary: "a", fallback: backup, manager: manager}
+			h.InjectContext(ctx)
+			if err := instance.AddFeature(obs); err != nil {
+				t.Fatal(err)
+			}
+			obs.states["roundRobin"] = map[string]bool{"a": true, "b": true} // unrelated scope must not authorize traffic.
+			assert := func(want string) {
+				t.Helper()
+				got, err := h.PickOutbound()
+				if got != want || (want == "" && !errors.Is(err, routing.ErrNoAvailableOutbound)) || (want != "" && err != nil) {
+					t.Fatalf("got %q %v want %q", got, err, want)
+				}
+			}
+			assert("")
+			obs.states["outbound"] = map[string]bool{"a": true, "b": true}
+			assert("a")
+			obs.states["outbound"]["a"] = false
+			assert(backup)
+			obs.states["outbound"]["b"] = false
+			assert("")
+			obs.states["outbound"]["a"] = true
+			assert("a")
+			delete(manager.tags, "a")
+			assert("")
+			manager.tags["a"] = true
+			obs.fail = true
+			assert("")
+		})
+	}
+}
+func TestDUIPriorityLevelsAllStrategies(t *testing.T) {
+	for _, mode := range []string{"random", "roundRobin", "leastLoad", "leastPing"} {
+		for _, direct := range []bool{false, true} {
+			t.Run(mode, func(t *testing.T) {
+				ctx, instance, manager, obs := healthFixture()
+				buildLevel := func(tags ...string) *BalancingRule {
+					return &BalancingRule{Strategy: mode, OutboundSelector: tags, StrategySettings: serial.ToTypedMessage(&StrategyLeastLoadConfig{Expected: 1})}
+				}
+				cfg := &BalancingRule{Strategy: "priority", PriorityLevels: []*BalancingRule{buildLevel("a", "b"), buildLevel("c", "d")}}
+				if direct {
+					cfg.PriorityLevels = append(cfg.PriorityLevels, buildLevel("direct"))
+				}
+				b, err := cfg.Build(manager, nil)
+				if err != nil {
+					t.Fatal(err)
+				}
+				b.InjectContext(ctx)
+				if err = instance.AddFeature(obs); err != nil {
+					t.Fatal(err)
+				}
+				assert := func(allowed ...string) {
+					t.Helper()
+					for i := 0; i < 20; i++ {
+						tag, err := b.PickOutbound()
+						if len(allowed) == 0 {
+							if tag != "" || !errors.Is(err, routing.ErrNoAvailableOutbound) {
+								t.Fatalf("leaked %q %v", tag, err)
+							}
+							continue
+						}
+						found := false
+						for _, v := range allowed {
+							found = found || tag == v
+						}
+						if err != nil || !found {
+							t.Fatalf("got %q %v want %v", tag, err, allowed)
+						}
+					}
+				}
+				obs.states[mode] = map[string]bool{"ab": true}
+				assert() // unknown and prefix neighbor are not healthy selections.
+				obs.states[mode] = map[string]bool{"a": true, "b": true, "c": true, "d": true, "direct": true}
+				assert("a", "b")
+				obs.states[mode]["a"] = false
+				assert("b")
+				obs.states[mode]["b"] = false
+				assert("c", "d")
+				obs.states[mode]["c"] = false
+				obs.states[mode]["d"] = false
+				if direct {
+					assert("direct")
+				} else {
+					assert()
+				}
+				obs.states[mode]["direct"] = false
+				assert()
+				obs.states[mode]["d"] = true
+				assert("d")
+				obs.states[mode]["a"] = true
+				assert("a")
+				obs.fail = true
+				assert()
+			})
+		}
+	}
+}
