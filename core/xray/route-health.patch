+package router
+
+import (
+	"context"
+	"github.com/xtls/xray-core/app/observatory"
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/features/extension"
+	"github.com/xtls/xray-core/features/outbound"
+	"github.com/xtls/xray-core/features/routing"
+)
+
+// Probes run continuously, independently of whether the route currently uses A or B.
+type outboundHealth struct {
+	primary, fallback string
+	ctx               context.Context
+	observer          extension.Observatory
+	manager           outbound.Manager
+}
+
+func (h *outboundHealth) InjectContext(ctx context.Context) {
+	h.ctx = ctx
+	if instance := core.FromContext(ctx); instance != nil {
+		common.Must(instance.RequireFeatures(func(observer extension.Observatory) error {
+			h.observer = observer
+			return nil
+		}, true))
+	}
+}
+
+func (h *outboundHealth) PickOutbound() (string, error) {
+	// Legacy/combined observations must never influence standalone routes.
+	scoped, ok := h.observer.(extension.StrategyObservatory)
+	if !ok {
+		return "", routing.ErrNoAvailableOutbound
+	}
+	message, err := scoped.GetObservationForStrategy(h.ctx, "outbound")
+	if err != nil {
+		return "", routing.ErrNoAvailableOutbound
+	}
+	report, ok := message.(*observatory.ObservationResult)
+	if !ok || report == nil {
+		return "", routing.ErrNoAvailableOutbound
+	}
+	alive := make(map[string]bool, len(report.Status))
+	for _, state := range report.Status {
+		if state != nil {
+			alive[state.OutboundTag] = state.Alive
+		}
+	}
+	for _, tag := range []string{h.primary, h.fallback} {
+		if tag != "" && alive[tag] && h.manager != nil && h.manager.GetHandler(tag) != nil {
+			return tag, nil
+		}
+	}
+	// Unknown, failed, expired or missing results all reject new connections.
+	return "", routing.ErrNoAvailableOutbound
+}
+
+// knownHealthy deliberately excludes missing observations and never uses a
+// different strategy's measurements, even for the same outbound tag.
+func knownHealthy(ctx context.Context, observer extension.Observatory, scope string, candidates []string) []string {
+	scoped, ok := observer.(extension.StrategyObservatory)
+	if !ok {
+		return nil
+	}
+	message, err := scoped.GetObservationForStrategy(ctx, scope)
+	if err != nil {
+		return nil
+	}
+	report, ok := message.(*observatory.ObservationResult)
+	if !ok || report == nil {
+		return nil
+	}
+	alive := map[string]bool{}
+	for _, state := range report.Status {
+		if state != nil {
+			alive[state.OutboundTag] = state.Alive
+		}
+	}
+	result := []string{}
+	for _, tag := range candidates {
+		if alive[tag] {
+			result = append(result, tag)
+		}
+	}
+	return result
+}
