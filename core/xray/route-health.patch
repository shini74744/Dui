+func TestDUIDispatchStandaloneAndPriorityRecovery(t *testing.T) {
+	for _, name := range []string{"standalone", "priority"} {
+		for _, fallback := range []string{""} {
+			t.Run(name+"/"+fallback, func(t *testing.T) {
+				instance := new(core.Instance)
+				ctx := context.WithValue(context.Background(), core.XrayKey(1), instance)
+				observer := &duiHealthDispatchObserver{duiDispatchObserver{a: true, b: false}}
+				if err := instance.AddFeature(observer); err != nil {
+					t.Fatal(err)
+				}
+				m := &duiDispatchManager{handlers: map[string]*duiDispatchHandler{}}
+				for _, tag := range []string{"a", "b", "direct", "backup"} {
+					m.handlers[tag] = &duiDispatchHandler{tag: tag}
+				}
+
+				r := new(router.Router)
+				rule := &router.RoutingRule{Networks: []net.Network{net.Network_TCP, net.Network_UDP}}
+				config := &router.Config{Rule: []*router.RoutingRule{rule}}
+				if name == "standalone" {
+					rule.TargetTag = &router.RoutingRule_Tag{Tag: "a"}
+					rule.FallbackTag = "b"
+					rule.OutboundHealthCheck = true
+				} else {
+					rule.TargetTag = &router.RoutingRule_BalancingTag{BalancingTag: "group"}
+					config.BalancingRule = []*router.BalancingRule{{Tag: "group", Strategy: "priority", PriorityLevels: []*router.BalancingRule{
+						{Strategy: "roundRobin", OutboundSelector: []string{"a"}},
+						{Strategy: "roundRobin", OutboundSelector: []string{"b"}},
+					}}}
+				}
+				if err := r.Init(ctx, config, nil, m, nil); err != nil {
+					t.Fatal(err)
+				}
+				d := &DefaultDispatcher{router: r, ohm: m}
+				dispatch := func(network net.Network) {
+					t.Helper()
+					dest := net.Destination{Network: network, Address: net.DomainAddress("example.invalid"), Port: 80}
+					callCtx := session.ContextWithOutbounds(ctx, []*session.Outbound{{Target: dest}})
+					reader, input := pipe.New()
+					output, writer := pipe.New()
+					defer input.Close()
+					defer output.Interrupt()
+					d.routedDispatch(callCtx, &transport.Link{Reader: reader, Writer: writer}, dest)
+					if _, err := output.ReadMultiBufferTimeout(time.Second); !errors.Is(err, io.EOF) {
+						t.Fatalf("output not closed: %v", err)
+					}
+					if _, err := reader.ReadMultiBufferTimeout(time.Second); err == nil {
+						t.Fatal("input not interrupted")
+					}
+				}
+				for _, network := range []net.Network{net.Network_TCP, net.Network_UDP} {
+					dispatch(network)
+				}
+				if m.handlers["a"].calls != 2 || m.handlers["b"].calls != 0 {
+					t.Fatal("failed member selected")
+				}
+				observer.a = false
+				for _, network := range []net.Network{net.Network_TCP, net.Network_UDP} {
+					dispatch(network)
+				}
+				if m.defaults != 0 {
+					t.Fatal("all failed leaked into default outbound")
+				}
+				if fallback != "" {
+					if m.handlers[fallback].calls != 2 {
+						t.Fatal("explicit fallback not used")
+					}
+				} else if m.handlers["direct"].calls != 0 || m.handlers["backup"].calls != 0 {
+					t.Fatal("implicit fallback")
+				}
+				observer.b = true
+				dispatch(net.Network_TCP)
+				if m.handlers["b"].calls != 1 {
+					t.Fatal("recovered member not reused")
+				}
+				observer.a = true
+				dispatch(net.Network_TCP)
+				if m.handlers["a"].calls != 3 {
+					t.Fatal("primary recovery did not preempt backup")
+				}
+				// Unmatched routing retains the ordinary default, only failed balancers reject.
+				if err := r.ReloadRules(&router.Config{}, false); err != nil {
+					t.Fatal(err)
+				}
+				dispatch(net.Network_TCP)
+				if m.defaults != 1 {
+					t.Fatal("unmatched default routing changed")
+				}
+			})
+		}
+	}
+}
