+
+	"github.com/xtls/xray-core/app/observatory"
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/features/extension"
+	_ "github.com/xtls/xray-core/main/distro/all"
+)
+
+func TestDUIBalancerLiveProbeFailoverAndRecovery(t *testing.T) {
+	var aliveA, aliveB atomic.Bool
+	aliveA.Store(true)
+	endpoint := func(tag string, alive *atomic.Bool) *httptest.Server {
+		return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			if alive != nil && !alive.Load() {
+				conn, _, err := w.(http.Hijacker).Hijack()
+				if err == nil {
+					conn.Close()
+				}
+				return
+			}
+			if r.URL.Path == "/probe" {
+				w.WriteHeader(204)
+				return
+			}
+			fmt.Fprint(w, tag)
+		}))
+	}
+	a, b, direct, backup := endpoint("member-a", &aliveA), endpoint("member-b", &aliveB), endpoint("direct", nil), endpoint("backup", nil)
+	defer a.Close()
+	defer b.Close()
+	defer direct.Close()
+	defer backup.Close()
+	scopes := map[string]any{}
+	balances := []any{}
+	rules := []any{}
+	groups := map[string]string{}
+	for _, name := range []string{"leastPing", "leastLoad", "random", "roundRobin"} {
+		if name == "leastPing" {
+			scopes[name] = map[string]any{"subjectSelector": []string{"member-a", "member-b"}, "probeURL": "http://probe.invalid/probe", "probeInterval": "100ms", "enableConcurrency": true}
+		} else {
+			scopes[name] = map[string]any{"subjectSelector": []string{"member-a", "member-b"}, "pingConfig": map[string]any{"destination": "http://probe.invalid/probe", "interval": "10s", "timeout": "1s", "sampling": 1, "connectivity": ""}}
+		}
+		for _, fallback := range []string{"", "direct", "backup"} {
+			group := name + "-" + fallback
+			groups[group] = fallback
+			balances = append(balances, map[string]any{"tag": group, "selector": []string{"member-a", "member-b"}, "strategy": map[string]any{"type": name}, "fallbackTag": fallback})
+			rules = append(rules, map[string]any{"type": "field", "inboundTag": []string{group}, "balancerTag": group})
+		}
+	}
+	outbounds := []any{}
+	for _, e := range []struct {
+		tag    string
+		server *httptest.Server
+	}{{"direct", direct}, {"member-a", a}, {"member-b", b}, {"backup", backup}} {
+		outbounds = append(outbounds, map[string]any{"tag": e.tag, "protocol": "freedom", "settings": map[string]any{"redirect": strings.TrimPrefix(e.server.URL, "http://")}})
+	}
+	payload, err := json.Marshal(map[string]any{"log": map[string]any{"loglevel": "none"}, "outbounds": outbounds, "routing": map[string]any{"balancers": balances, "rules": rules}, "strategyObservatory": scopes})
+	if err != nil {
+		t.Fatal(err)
+	}
+	instance, err := core.StartInstance("json", payload)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer instance.Close()
+	observer := instance.GetFeature(extension.ObservatoryType()).(extension.StrategyObservatory)
+	waitHealth := func(wantA, wantB bool) {
+		t.Helper()
+		deadline := time.Now().Add(35 * time.Second)
+		for time.Now().Before(deadline) {
+			ready := true
+			for name := range scopes {
+				msg, err := observer.GetObservationForStrategy(context.Background(), name)
+				if err != nil {
+					t.Fatal(err)
+				}
+				statuses := map[string]bool{}
+				for _, s := range msg.(*observatory.ObservationResult).Status {
+					statuses[s.OutboundTag] = s.Alive
+				}
+				if len(statuses) != 2 || statuses["member-a"] != wantA || statuses["member-b"] != wantB {
+					ready = false
+				}
+			}
+			if ready {
+				return
+			}
+			time.Sleep(50 * time.Millisecond)
+		}
+		t.Fatalf("probes did not reach a=%v b=%v", wantA, wantB)
+	}
+	request := func(group string) (string, error) {
+		ctx := session.ContextWithInbound(context.Background(), &session.Inbound{Tag: group})
+		tr := &http.Transport{DisableKeepAlives: true, DialContext: func(_ context.Context, network, address string) (net.Conn, error) {
+			return core.Dial(ctx, instance, xnet.TCPDestination(xnet.DomainAddress("payload.invalid"), 80))
+		}}
+		defer tr.CloseIdleConnections()
+		client := &http.Client{Transport: tr, Timeout: 3 * time.Second}
+		resp, err := client.Get("http://payload.invalid/payload")
+		if err != nil {
+			return "", err
+		}
+		defer resp.Body.Close()
+		content, err := io.ReadAll(resp.Body)
+		return string(content), err
+	}
+	waitHealth(true, false)
+	for group := range groups {
+		for i := 0; i < 3; i++ {
+			if got, err := request(group); err != nil || got != "member-a" {
+				t.Fatalf("partial failure %s: %q %v", group, got, err)
+			}
+		}
+	}
+	t.Log("all four strategies use only the healthy member without requiring fallback")
+	aliveA.Store(false)
+	waitHealth(false, false)
+	for group, fallback := range groups {
+		got, err := request(group)
+		if fallback == "" {
+			if err == nil {
+				t.Fatalf("all failed %s leaked via %q", group, got)
+			}
+		} else if err != nil || got != fallback {
+			t.Fatalf("explicit fallback %s: %q %v", group, got, err)
+		}
+	}
+	t.Log("all failed: unset fallback rejects; direct/backup require explicit selection")
+	aliveB.Store(true)
+	waitHealth(false, true)
+	for group := range groups {
+		if got, err := request(group); err != nil || got != "member-b" {
+			t.Fatalf("recovery %s: %q %v", group, got, err)
+		}
+	}
+	t.Log("probes continue while rejected and recovered members are automatically reused")
+}
