+
+import "errors"
+
+// ErrNoAvailableOutbound means a matched balancer cannot select an outbound.
+// Dispatchers must reject this connection instead of using the default route.
+// Health probes continue and subsequent connections may succeed after recovery.
+var ErrNoAvailableOutbound = errors.New("no available balancer outbound")
