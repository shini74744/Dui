+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/pipe"
+	"google.golang.org/protobuf/proto"
+)
+
+type duiDispatchObserver struct{ a, b bool }
+
+func (*duiDispatchObserver) Type() interface{} { return extension.ObservatoryType() }
+func (*duiDispatchObserver) Start() error      { return nil }
+func (*duiDispatchObserver) Close() error      { return nil }
+func (o *duiDispatchObserver) GetObservation(context.Context) (proto.Message, error) {
+	return &observatory.ObservationResult{Status: []*observatory.OutboundStatus{
+		{OutboundTag: "a", Alive: o.a, Delay: 10}, {OutboundTag: "b", Alive: o.b, Delay: 20},
+	}}, nil
+}
+
+type duiDispatchHandler struct {
+	outbound.Handler
+	tag   string
+	calls int
+}
+
+func (h *duiDispatchHandler) Tag() string { return h.tag }
+func (h *duiDispatchHandler) Dispatch(_ context.Context, link *transport.Link) {
+	h.calls++
+	common.Close(link.Writer)
+	common.Interrupt(link.Reader)
+}
+
+type duiDispatchManager struct {
+	outbound.Manager
+	handlers map[string]*duiDispatchHandler
+	defaults int
+}
+
+func (m *duiDispatchManager) Select([]string) []string { return []string{"a", "b"} }
+func (m *duiDispatchManager) GetHandler(tag string) outbound.Handler {
+	if h := m.handlers[tag]; h != nil {
+		return h
+	}
+	return nil
+}
+func (m *duiDispatchManager) GetDefaultHandler() outbound.Handler {
+	m.defaults++
+	return m.handlers["direct"]
+}
+
+func TestDUIDispatchBalancerHealthRecoveryAndExplicitFallback(t *testing.T) {
+	for _, name := range []string{"leastPing", "leastLoad", "random", "roundRobin"} {
+		for _, fallback := range []string{"", "backup", "direct"} {
+			t.Run(name+"/"+fallback, func(t *testing.T) {
+				instance := new(core.Instance)
+				ctx := context.WithValue(context.Background(), core.XrayKey(1), instance)
+				observer := &duiDispatchObserver{a: true, b: false}
+				if err := instance.AddFeature(observer); err != nil {
+					t.Fatal(err)
+				}
+				m := &duiDispatchManager{handlers: map[string]*duiDispatchHandler{}}
+				for _, tag := range []string{"a", "b", "direct", "backup"} {
+					m.handlers[tag] = &duiDispatchHandler{tag: tag}
+				}
+				balance := &router.BalancingRule{Tag: "group", OutboundSelector: []string{"a", "b"}, Strategy: name, FallbackTag: fallback}
+				if name == "leastLoad" {
+					balance.StrategySettings = serial.ToTypedMessage(&router.StrategyLeastLoadConfig{Expected: 1})
+				}
+				r := new(router.Router)
+				config := &router.Config{BalancingRule: []*router.BalancingRule{balance}, Rule: []*router.RoutingRule{{
+					Networks:  []net.Network{net.Network_TCP, net.Network_UDP},
+					TargetTag: &router.RoutingRule_BalancingTag{BalancingTag: "group"},
+				}}}
+				if err := r.Init(ctx, config, nil, m, nil); err != nil {
+					t.Fatal(err)
+				}
+				d := &DefaultDispatcher{router: r, ohm: m}
+				dispatch := func(network net.Network) {
+					t.Helper()
+					dest := net.Destination{Network: network, Address: net.DomainAddress("example.invalid"), Port: 80}
+					callCtx := session.ContextWithOutbounds(ctx, []*session.Outbound{{Target: dest}})
+					reader, input := pipe.New()
+					output, writer := pipe.New()
+					defer input.Close()
+					defer output.Interrupt()
+					d.routedDispatch(callCtx, &transport.Link{Reader: reader, Writer: writer}, dest)
+					if _, err := output.ReadMultiBufferTimeout(time.Second); !errors.Is(err, io.EOF) {
+						t.Fatalf("output not closed: %v", err)
+					}
+					if _, err := reader.ReadMultiBufferTimeout(time.Second); err == nil {
+						t.Fatal("input not interrupted")
+					}
+				}
+				for _, network := range []net.Network{net.Network_TCP, net.Network_UDP} {
+					dispatch(network)
+				}
+				if m.handlers["a"].calls != 2 || m.handlers["b"].calls != 0 {
+					t.Fatal("failed member selected")
+				}
+				observer.a = false
+				for _, network := range []net.Network{net.Network_TCP, net.Network_UDP} {
+					dispatch(network)
+				}
+				if m.defaults != 0 {
+					t.Fatal("all failed leaked into default outbound")
+				}
+				if fallback != "" {
+					if m.handlers[fallback].calls != 2 {
+						t.Fatal("explicit fallback not used")
+					}
+				} else if m.handlers["direct"].calls != 0 || m.handlers["backup"].calls != 0 {
+					t.Fatal("implicit fallback")
+				}
+				observer.b = true
+				dispatch(net.Network_TCP)
+				if m.handlers["b"].calls != 1 {
+					t.Fatal("recovered member not reused")
+				}
+				// Unmatched routing retains the ordinary default, only failed balancers reject.
+				if err := r.ReloadRules(&router.Config{}, false); err != nil {
+					t.Fatal(err)
+				}
+				dispatch(net.Network_TCP)
+				if m.defaults != 1 {
+					t.Fatal("unmatched default routing changed")
+				}
+			})
+		}
+	}
+}
