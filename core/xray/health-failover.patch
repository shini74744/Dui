+type duiAvailabilityObserver struct{ alive map[string]bool }
+
+func (o *duiAvailabilityObserver) Type() interface{} { return extension.ObservatoryType() }
+func (o *duiAvailabilityObserver) Start() error      { return nil }
+func (o *duiAvailabilityObserver) Close() error      { return nil }
+func (o *duiAvailabilityObserver) GetObservation(context.Context) (proto.Message, error) {
+	result := &observatory.ObservationResult{}
+	for _, tag := range []string{"a", "b"} {
+		if alive, ok := o.alive[tag]; ok {
+			result.Status = append(result.Status, &observatory.OutboundStatus{
+				OutboundTag: tag, Alive: alive, Delay: 10,
+				HealthPing: &observatory.HealthPingMeasurementResult{All: 2, Average: 10000000, Deviation: 1000000},
+			})
+		}
+	}
+	return result, nil
+}
+
+type duiAvailabilityManager struct {
+	outbound.Manager
+	tags []string
+}
+
+func (m *duiAvailabilityManager) Select([]string) []string { return m.tags }
+
+func duiAvailabilityStrategy(name, fallback string) BalancingStrategy {
+	switch name {
+	case "leastPing":
+		return &LeastPingStrategy{}
+	case "leastLoad":
+		return NewLeastLoadStrategy(&StrategyLeastLoadConfig{Expected: 1})
+	case "random":
+		return &RandomStrategy{FallbackTag: fallback}
+	default:
+		return &RoundRobinStrategy{FallbackTag: fallback}
+	}
+}
+
+func TestDUIBalancerFailureAndRecoveryWithoutImplicitDefault(t *testing.T) {
+	for _, name := range []string{"leastPing", "leastLoad", "random", "roundRobin"} {
+		for _, fallback := range []string{"", "backup", "direct"} {
+			t.Run(name+"/"+fallback, func(t *testing.T) {
+				instance := new(core.Instance)
+				ctx := context.WithValue(context.Background(), core.XrayKey(1), instance)
+				observer := &duiAvailabilityObserver{alive: map[string]bool{"a": true, "b": false}}
+				manager := &duiAvailabilityManager{tags: []string{"a", "b"}}
+				b := &Balancer{strategy: duiAvailabilityStrategy(name, fallback), ohm: manager, fallbackTag: fallback}
+				// Exercise deferred dependency registration, not direct observer assignment.
+				b.InjectContext(ctx)
+				if err := instance.AddFeature(observer); err != nil {
+					t.Fatal(err)
+				}
+				for i := 0; i < 50; i++ {
+					if got, err := b.PickOutbound(); err != nil || got != "a" {
+						t.Fatalf("partial failure: got %q, %v", got, err)
+					}
+				}
+				observer.alive["a"] = false
+				got, err := b.PickOutbound()
+				if fallback == "" {
+					if got != "" || !errors.Is(err, routing.ErrNoAvailableOutbound) {
+						t.Fatalf("all failed must reject: %q, %v", got, err)
+					}
+				} else if err != nil || got != fallback {
+					t.Fatalf("explicit fallback: %q, %v", got, err)
+				}
+				observer.alive["b"] = true
+				for i := 0; i < 50; i++ {
+					if got, err := b.PickOutbound(); err != nil || got != "b" {
+						t.Fatalf("recovery: got %q, %v", got, err)
+					}
+				}
+				manager.tags = nil
+				got, err = b.PickOutbound()
+				if fallback == "" {
+					if got != "" || !errors.Is(err, routing.ErrNoAvailableOutbound) {
+						t.Fatalf("empty selector must reject: %q, %v", got, err)
+					}
+				} else if err != nil || got != fallback {
+					t.Fatalf("empty selector fallback: %q, %v", got, err)
+				}
+			})
+		}
+	}
+}
+
+func TestDUIRandomRoundRobinObserverOptional(t *testing.T) {
+	for _, name := range []string{"random", "roundRobin"} {
+		t.Run(name, func(t *testing.T) {
+			instance := new(core.Instance)
+			ctx := context.WithValue(context.Background(), core.XrayKey(1), instance)
+			strategy := duiAvailabilityStrategy(name, "")
+			strategy.(extension.ContextReceiver).InjectContext(ctx)
+			for i := 0; i < 20; i++ {
+				got := strategy.PickOutbound([]string{"a", "b"})
+				if got != "a" && got != "b" {
+					t.Fatalf("no observer: %q", got)
+				}
+			}
+			observer := &duiAvailabilityObserver{alive: map[string]bool{"a": false, "b": true}}
+			if err := instance.AddFeature(observer); err != nil {
+				t.Fatal(err)
+			}
+			for i := 0; i < 20; i++ {
+				if got := strategy.PickOutbound([]string{"a", "b"}); got != "b" {
+					t.Fatalf("configured observer ignored: %q", got)
+				}
+			}
+		})
+	}
+}
+
+func TestDUIBalancerSelectionErrorCannotUseDefault(t *testing.T) {
+	b := &Balancer{strategy: &RandomStrategy{}, ohm: &struct{ outbound.Manager }{}}
+	if _, err := b.PickOutbound(); !errors.Is(err, routing.ErrNoAvailableOutbound) {
+		t.Fatalf("got %v", err)
+	}
+	b.fallbackTag = "backup"
+	if got, err := b.PickOutbound(); err != nil || got != "backup" {
+		t.Fatalf("%q, %v", got, err)
+	}
+}
